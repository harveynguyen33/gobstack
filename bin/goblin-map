#!/usr/bin/env bash
# goblin-map — the feature-map VALIDATOR (INTERNAL helper).
#
# This file is NOT a verb: `gob map` no longer exists. The map is authored by the agent
# inside the `gob init` proposal and installed in the same pass. `gob init --write` extracts
# the embedded feature files and calls THIS validator on them before it writes anything, so
# the FM-01 shape and FM-02 resolvability are checked by one code path (here), never
# re-implemented in the init flow.
#
#   goblin-map --validate <mapdir> [--root <reporoot>]
#
#     <mapdir>  the directory holding README.md (the index) and the <slug>.md feature files.
#     --root    the repo root the declared entry paths resolve against and `git ls-files`
#               runs in (default: $PWD). `gob init --write` passes the target repo.
#
# What it validates (fail closed, exit 2 the moment anything is wrong):
#   FM-01 shape   README.md exists and indexes every feature via `](./<slug>.md)`; every
#                 relative link in the index resolves; >=1 feature file; each feature file
#                 carries frontmatter, `feature:` equals its filename stem, >=1 entry_paths
#                 item each a single whitespace-free token, EXACTLY the four contract H2s in
#                 order, and a `verified:` that is a date or the never-driven form.
#   FM-02 resolve every entry path EXISTS under <root> AND is tracked by git (`git ls-files`),
#                 so a map cannot claim a `verified:` date over uncommitted source.
#
# Exit codes: 0 the map validates | 2 bad input or a failed clause (a reason is printed).
# No npm, no jq, no yq, no network. bash/awk/sed/grep/find only (the repo constraint).

set -uo pipefail

g_err() { printf 'error: map: %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
goblin-map --validate <mapdir> [--root <reporoot>]

The INTERNAL feature-map validator. `gob map` is not a verb — `gob init --write` runs this
against the map embedded in the proposal, before it installs. You do not call it by hand
unless you are debugging the map the proposal asked for.
USAGE
}

MAPDIR=""
ROOT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --validate) [ -n "$MAPDIR" ] && { g_err "validate dir given twice"; exit 2; }
                MAPDIR="${2:-}"; shift 2 ;;
    --root)     [ -n "$ROOT" ] && { g_err "root given twice"; exit 2; }
                ROOT="${2:-}"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    *) g_err "unknown argument: $1"; usage >&2; exit 2 ;;
  esac
done

[ -n "$MAPDIR" ] || { g_err "--validate <mapdir> is required"; usage >&2; exit 2; }
[ -d "$MAPDIR" ] || { g_err "map dir does not exist: $MAPDIR"; exit 2; }
MAPDIR=$(cd "$MAPDIR" && pwd) || { g_err "cannot enter: $MAPDIR"; exit 2; }
ROOT="${ROOT:-$PWD}"
[ -d "$ROOT" ] || { g_err "--root is not a directory: $ROOT"; exit 2; }
ROOT=$(cd "$ROOT" && pwd) || { g_err "cannot enter root: $ROOT"; exit 2; }

BAD=0

# fm_frontmatter <file> - the body of the leading --- block.
fm_frontmatter() {
  awk 'BEGIN{fm=0} /^---[[:space:]]*$/ {fm++; if (fm==1) next; else exit} fm==1 {print}' "$1"
}

# fm_entry_paths <file> - one declared entry path per line.
fm_entry_paths() {
  fm_frontmatter "$1" | awk '
    /^entry_paths:/      { inb = 1; next }
    inb && /^  - /       { v = $0; sub(/^  - /, "", v); sub(/[[:space:]]+$/, "", v); print v; next }
    inb && !/^[[:space:]]/ { inb = 0 }
  '
}

# fm_h2_ok <file> - exactly the four contract H2s, in order. The third is a PREFIX match: the
# map names the project's own harness ("Driving it with <harness>"), so a literal would make the
# rule un-portable.
fm_h2_ok() {
  local n=0 ok=1 line
  while IFS= read -r line; do
    n=$((n + 1))
    case "$n" in
      1) [ "$line" = "Sub-features" ] || ok=0 ;;
      2) [ "$line" = "How to get to it (user POV)" ] || ok=0 ;;
      3) case "$line" in "Driving it with "*) ;; *) ok=0 ;; esac ;;
      4) [ "$line" = "Gotchas" ] || ok=0 ;;
      *) ok=0 ;;
    esac
  done < <(grep -n '^## ' "$1" | sed 's/^[0-9]*:## //; s/[[:space:]]*$//')
  [ "$n" -eq 4 ] && [ "$ok" -eq 1 ]
}

# ---------------------------------------------------------------- FM-01 shape ---
READMEF="$MAPDIR/README.md"
if [ ! -f "$READMEF" ]; then
  g_err "$MAPDIR carries no README.md index — the map is the index plus one <slug>.md per feature"
  exit 2
fi

N=0
for f in "$MAPDIR"/*.md; do
  [ -f "$f" ] || continue
  case "$(basename "$f")" in README.md) continue ;; esac
  N=$((N + 1))
  b=$(basename "$f")
  slug=${b%.md}
  # index hygiene: this feature file is linked from README.md in the (./<slug>.md) form.
  grep -qF "](./$b)" "$READMEF" \
    || { g_err "$b is not linked from README.md as (./$b)"; BAD=1; }
  # frontmatter block present
  sed -n '1,2p' "$f" | grep -q '^---[[:space:]]*$' \
    || { g_err "$b: no frontmatter block (must start: ---)"; BAD=1; continue; }
  fm=$(fm_frontmatter "$f")
  printf '%s\n' "$fm" | grep -q "^feature:[[:space:]]*$slug[[:space:]]*\$" \
    || { g_err "$b: feature: must equal the filename stem ($slug)"; BAD=1; }
  eps=$(fm_entry_paths "$f" | grep -c . || true)
  [ "${eps:-0}" -ge 1 ] \
    || { g_err "$b: entry_paths: carries no item (>=1 repo-relative path that exists)"; BAD=1; }
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    case "$tok" in *[[:space:]]*) g_err "$b: entry path is not a single token: $tok"; BAD=1; continue ;; esac
  done < <(fm_entry_paths "$f")
  v=$(printf '%s\n' "$fm" | sed -n 's/^verified:[[:space:]]*//p')
  case "$v" in
    "") g_err "$b: no verified: line"; BAD=1 ;;
    never-driven*) : ;;
    *) case "$v" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;; *)
         g_err "$b: verified: must be a date or the never-driven form (got: $v)"; BAD=1 ;;
       esac ;;
  esac
  fm_h2_ok "$f" \
    || { g_err "$b: the H2s are not the contract four, in order (Sub-features / How to get to it (user POV) / Driving it with <harness> / Gotchas)"; BAD=1; }
done
[ "$N" -ge 1 ] \
  || { g_err "$MAPDIR indexes no feature file — an empty map is a hole, not a pass"; BAD=1; }

# every relative link in the index must resolve inside the map dir
while IFS= read -r link; do
  [ -e "$MAPDIR/$link" ] || { g_err "README.md links $link, which does not resolve"; BAD=1; }
done < <(sed -n 's/.*](\.\/\([^)]*\.md\)).*/\1/p' "$READMEF")

# ---------------------------------------------------------------- FM-02 resolve -
for f in "$MAPDIR"/*.md; do
  [ -f "$f" ] || continue
  case "$(basename "$f")" in README.md) continue ;; esac
  b=$(basename "$f")
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    if [ ! -e "$ROOT/$e" ]; then
      g_err "$b: entry path \"$e\" does not exist under $ROOT"
      BAD=1
      continue
    fi
    if ! git -C "$ROOT" ls-files --error-unmatch -- "$e" >/dev/null 2>&1; then
      g_err "$b: entry path \"$e\" is not tracked by git — commit it before the map claims it"
      BAD=1
    fi
  done < <(fm_entry_paths "$f")
done

[ "$BAD" -eq 0 ] || exit 2
printf 'map valid: %s — %d feature file(s), every entry path resolves and is tracked\n' "$MAPDIR" "$N"
exit 0
