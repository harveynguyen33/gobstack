#!/usr/bin/env bash
# goblin — the CLI dispatcher.
#
#   gob init    [--heuristic | --write <proposal>] [--target <dir>] [...]
#   gob map     [target] [--agent | --heuristic] [--write <dir>] [--force]
#   gob verify  [--only <id[,id...]>] [--json] [--list] [--source <path>]
#   gob bans    [--only <id[,id...]>] [--list]
#   gob mcp                                     serve the harness over MCP stdio
#   gob uninstall --target <dir>
#   gob --version
#
# v2 SURFACE (AI-driven development): the CLI calls no AI API. `gob init` and `gob map`
# EMIT a prompt + schema that the agent already running in this repo fulfils with its own
# tools; heuristic detection demotes to the --heuristic fallback.
#
# UNWIRED this session (code kept under bin/, deletion is session 3): doctor, audit,
# upgrade, emit/sync. `sync` becomes an init-internal step (hidden --resync flag).
#
# Identity: the package is gobstack (npm @techgoblin/gobstack), the command is `gob`
# (`goblin` remains as a legacy alias).
#
# The four-value verify contract is unchanged and non-negotiable (bin/goblin-verify:5-9):
#   0  every executed check passed
#   1  at least one check failed
#   2  could not run
#   3  the manifest itself is broken
# Every subcommand propagates the engine's exit code verbatim; no wrapper translates a
# 1 into a 0.
#
# Root resolution: find_installed_root() walks up from $PWD to an AGENTS.md carrying the
# gob marker block; fall back to git toplevel, then $PWD — the D20 nested-repo fix.
#
# No npm, no jq, no yq, no network. bash/awk/sed/grep only.

set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=$(cd "$SELF_DIR/.." && pwd)
VERSION=$(cat "$SRC/VERSION" 2>/dev/null || printf 'unknown')

g_err() { printf 'error: %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
gob — the gobstack command line.

  gob init    [--heuristic | --write <proposal>] [--target <dir>] [--class app|A-F] [--dry-run]
  gob map     [target] [--agent | --heuristic] [--write <dir>] [--force]
  gob verify  [--only <id[,id...]>] [--json] [--list] [--source <path>]
  gob bans    [--only <id[,id...]>] [--list]
  gob mcp     serve the harness to your agent over MCP stdio (verify/map/init tools)
  gob uninstall --target <dir>
  gob --version

gob init and gob map are AI-DRIVEN: they print a prompt + schema for the agent already
running in this repo, which writes the proposal file; `--write` validates and installs
it. The heuristic detectors are the --heuristic fallback.

Exit codes (verify): 0 pass | 1 a check failed | 2 could not run | 3 the manifest is
broken. Every subcommand propagates the engine's exit code verbatim.
USAGE
}

# ---- the repo-root locator (an AGENTS.md gob block is the install marker) ----
find_installed_root() {
  local d="$PWD"
  while :; do
    if [ -f "$d/AGENTS.md" ] && grep -q '^<!-- gob:begin' "$d/AGENTS.md" 2>/dev/null; then
      printf '%s\n' "$d"; return 0
    fi
    [ "$d" = "/" ] && return 1
    d=$(dirname "$d")
  done
}

# ---- subcommand dispatch ------------------------------------------------------
CMD="${1:-}"
[ -n "$CMD" ] || { usage; exit 2; }
shift

case "$CMD" in
  init)
    # The prompt+schema engine: prints the agent brief, or installs a proposal.
    exec bash "$SRC/bin/goblin-init" "$@"
    ;;
  map)
    # The standalone feature-map generator: `--agent` (default) prints prompt+schema;
    # --heuristic runs the scanner. Routes and propagates its 0/1/2 contract verbatim.
    exec bash "$SRC/bin/goblin-map" "$@"
    ;;
  verify)
    # The engine is whatever the per-repo chain resolves (W1 §2.3): --source, vendored,
    # engine_dir:, GOBLIN_ENGINE_DIR, ~/.goblin/engine — all inside goblin-verify. The
    # CLI is a pass-through, not a second root-resolution opinion (§3.4).
    exec bash "$SRC/bin/goblin-verify" "$@"
    ;;
  bans)
    exec bash "$SRC/bin/goblin-bans" "$@"
    ;;
  mcp)
    # The MCP stdio server (bin/goblin-mcp.js): JSON-RPC 2.0 over stdin/stdout, a LOCAL
    # tool server over the vendored harness — no API call, no socket. node is the same
    # runtime bin/goblin.js already needs; it is exec'd directly, args pass through.
    exec node "$SRC/bin/goblin-mcp.js" "$@"
    ;;
  uninstall)
    # Routes into the installer's uninstall job. `--uninstall` is appended FIRST so the
    # user's own `--target <dir>` and options still parse.
    exec bash "$SRC/bin/goblin-install" --uninstall "$@"
    ;;
  --version|-V|-v)
    printf '%s\n' "$VERSION"
    exit 0
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  doctor|audit|upgrade|emit|sync|install)
    # Unwired from usage in v2 (code kept; deletion is session 3). The refusal names
    # what replaced each verb rather than silently executing the old path.
    g_err "gob $CMD is unwired in v2."
    case "$CMD" in
      install|init-legacy) g_err "fix: gob init --write <proposal> installs a repo now." ;;
      sync|emit)           g_err "fix: gob init --write <proposal> runs the sync step internally." ;;
      doctor|audit|upgrade) g_err "fix: gob verify (audit stays a deliberate manual step; see docs/)." ;;
    esac
    exit 2
    ;;
  *)
    g_err "unknown subcommand: $CMD"
    usage >&2
    exit 2
    ;;
esac
