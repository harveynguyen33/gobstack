#!/usr/bin/env bash
# goblin-model — resolve a ROLE to provider/model/effort, by reading one mapping file.
#
# Usage:
#   goblin-model <role> [--models <file>] [--config <goblin.yaml>] [--roles <roles.yaml>] [--json]
#   goblin-model --list
#
# A role is what the work needs (code | judgment | review-panel | synthesis | investigate).
# A profile is a worker identity. This tool never invents a model: it looks the role's
# default profile up in the mapping file and prints what that file says.
#
# The mapping file is the ONE install-time machine input. goblin-stack READS it and never
# writes it. Absent on this machine -> every role resolves to `unknown`, and the model-related
# checks in goblin-verify report advisory instead of failing.
#
# Output, one line per lane:   <profile> <provider> <model> <effort>

set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=goblin-lib.sh
. "$SELF_DIR/goblin-lib.sh"

ROLE=""
MODELS="${GOBLIN_MODELS:-$HOME/projects/fleet-model.yaml}"
CONFIG=""
ROLES=""
JSON=0
LIST=0

while [ $# -gt 0 ]; do
  case "$1" in
    --models) MODELS="${2:-}"; MODELS_EXPLICIT=1; shift 2 ;;
    --config) CONFIG="${2:-}"; shift 2 ;;
    --roles)  ROLES="${2:-}"; shift 2 ;;
    --json)   JSON=1; shift ;;
    --list)   LIST=1; shift ;;
    -h|--help) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) g_err "unknown option: $1"; exit 2 ;;
    *)  ROLE="$1"; shift ;;
  esac
done

ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$ROOT" ] || ROOT="$PWD"

# Config: explicit, else the installed one, else none.
if [ -z "$CONFIG" ]; then
  if [ -f "$ROOT/.goblin/goblin.yaml" ]; then CONFIG="$ROOT/.goblin/goblin.yaml"; fi
fi
if [ -n "$CONFIG" ] && [ -z "${MODELS_EXPLICIT:-}" ]; then
  m=$(g_yaml_scalar "$CONFIG" models_file)
  [ -n "$m" ] && MODELS="$m"
fi
MODELS=$(g_expand_tilde "$MODELS")

if [ -z "$ROLES" ]; then
  if [ -f "$ROOT/.goblin/roles.yaml" ]; then ROLES="$ROOT/.goblin/roles.yaml"
  else ROLES="$SELF_DIR/../roles.yaml"; fi
fi
[ -f "$ROLES" ] || { g_err "no roles file at $ROLES"; exit 2; }

roles_list() {
  awk '/^role-/{ n = $0; sub(/^role-/, "", n); sub(/:.*/, "", n); print n }' "$ROLES"
}

if [ "$LIST" -eq 1 ]; then
  for r in $(roles_list); do
    printf '%-14s %s\n' "$r" "$(g_yaml_block_scalar "$ROLES" "role-$r" capability)"
  done
  exit 0
fi

[ -n "$ROLE" ] || { g_err "a role is required (see --list)"; exit 2; }

if ! roles_list | grep -qx "$ROLE"; then
  g_err "unknown role '$ROLE'; known: $(roles_list | paste -sd'|' -)"
  exit 2
fi

profiles=$(g_yaml_block_scalar "$ROLES" "role-$ROLE" profiles)
profiles=$(printf '%s' "$profiles" | tr -d '[]' | tr ',' ' ')
[ -n "${profiles// /}" ] || { g_err "role $ROLE declares no profiles"; exit 2; }

if [ ! -f "$MODELS" ]; then
  g_info "no model mapping configured: $MODELS is absent"
  for p in $profiles; do
    if [ "$JSON" -eq 1 ]; then printf '{"role":"%s","profile":"%s","provider":"unknown","model":"unknown","effort":"unknown"}\n' "$ROLE" "$p"
    else printf '%s unknown unknown unknown\n' "$p"; fi
  done
  exit 0
fi

for p in $profiles; do
  prov=$(g_models_field "$MODELS" "$p" provider)
  model=$(g_models_field "$MODELS" "$p" model)
  eff=$(g_models_field "$MODELS" "$p" effort)
  prov=${prov:-unknown}; model=${model:-unknown}; eff=${eff:-unknown}
  if [ "$JSON" -eq 1 ]; then
    printf '{"role":"%s","profile":"%s","provider":"%s","model":"%s","effort":"%s"}\n' "$ROLE" "$p" "$prov" "$model" "$eff"
  else
    printf '%s %s %s %s\n' "$p" "$prov" "$model" "$eff"
  fi
done
exit 0
