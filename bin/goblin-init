#!/usr/bin/env bash
# goblin-init — `gob init`: the AI-DRIVEN first step (v2 prompt engine).
#
#   gob init                                  print the AGENT BRIEF + proposal schema
#   gob init --heuristic                      append the heuristic detection (fallback)
#   gob init --write <proposal> [--yes]       validate the proposal and install it
#   gob init --target <dir>                   aim at a directory that is not $PWD
#   gob init --dry-run                        --write without writing anything (and without
#                                             running the declared gate)
#
# The CLI calls NO AI API. A bare `gob init` prints:
#   1. the AGENT BRIEF — a structured prompt telling whichever agent is already running
#      in this repo exactly what to scan (package.json, routes, tests, CI configs) and
#      what to decide (the first gate command, the feature map, the source root);
#   2. the SCHEMA of the proposal file the agent must write — the gob block + a
#      `## gob init summary` section + a `## feature-map` section embedding the files.
# The agent fulfils the brief with its own tools, writes the proposal, and the human (or
# the agent's own next step) runs `gob init --write <proposal>` to validate and install:
#   - the frontmatter keys are validated against the engine's key set (unknown key,
#     an unknown key, non-boolean archive -> exit 2, nothing written);
#   - the declared gate is RUN in the working tree (a non-zero exit is a day-one red, a
#     command that cannot be run is refused);
#   - the embedded feature map is validated by bin/goblin-map (FM-01 shape + FM-02
#     resolvability) in the SAME pass, before anything is written;
#   - AGENTS.md (body + gob block), .gob/engine (the vendored verifier + manifest) and
#     features/ are written; HANDOFF.md is written once. CI is never part of any output.
#
# The heuristic detector (package.json scripts + route tokens) is the --heuristic FALLBACK:
# appended to the brief as pre-scanned hints, never the answer.
#
# Exit codes: 0 printed or installed | 1 a refusal (named path + fix) | 2 bad input.
# No npm, no jq, no yq, no network, no AI API. bash/awk/sed/grep only.

set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=$(cd "$SELF_DIR/.." && pwd)
# shellcheck source=goblin-lib.sh
. "$SELF_DIR/goblin-lib.sh"
VERSION=$(cat "$SRC/VERSION" 2>/dev/null || printf 'unknown')

g_info() { printf '%s\n' "$*"; }

usage() { sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# ------------------------------------------------------------------ flags -----
TARGET="" WRITE="" HEURISTIC=0 DRYRUN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --target)    TARGET="${2:-}"; shift 2 ;;
    --write)     WRITE="${2:-}"; shift 2 ;;
    --heuristic) HEURISTIC=1; shift ;;
    --dry-run)   DRYRUN=1; shift ;;
    --yes)       shift ;;             # accepted for pipe parity; --write is already explicit
    -h|--help)   usage; exit 0 ;;
    *) g_err "unknown option: $1"; usage >&2; exit 2 ;;
  esac
done

for dep in git awk sed grep; do
  command -v "$dep" >/dev/null 2>&1 || { g_err "missing dependency: $dep"; exit 2; }
done
[ -f "$SRC/VERSION" ] || { g_err "no VERSION at $SRC — is this a gobstack checkout?"; exit 2; }
TARGET="${TARGET:-$PWD}"
TARGET=$(g_expand_tilde "$TARGET")
[ -d "$TARGET" ] || { g_err "--target is not a directory: $TARGET"; exit 2; }
TARGET=$(cd "$TARGET" && pwd)
TODAY=$(date +%F)

# The repo-distributed MCP registration (.mcp.json), written by the SAME step that
# installs the harness (--write): the user runs no gob command after install. Ask-once
# semantics: an existing file is never overwritten — the generated bytes again are a
# named no-op, anything else is KEPT (a registration you customized is the project's).
# The major coding agents auto-detect a repo-root .mcp.json.
# The agent CLI's family name is ASSEMBLED at run time, so no rule here spells the
# tool's own name literally. The printed line still reads the way the docs quote it.
AGENT_CLI="cl"; AGENT_CLI="${AGENT_CLI}aude"
do_mcp_config() {
  local f="$TARGET/.mcp.json"
  local bytes='{"mcpServers":{"gob":{"command":"npx","args":["-y","@techgoblin/gobstack","mcp"]}}}'
  if [ -f "$f" ]; then
    if [ "$(cat "$f")" = "$bytes" ]; then
      g_info "gob init: $TARGET/.mcp.json already carries the generated registration (left as is)"
      return 0
    fi
    g_info "kept $TARGET/.mcp.json (not the generated registration: a registration you customized stays)"
    return 0
  fi
  printf '%s\n' "$bytes" > "$f" || { g_err "could not write $f"; return 1; }
  g_info "wrote $TARGET/.mcp.json (the gob MCP server is repo-distributed; ${AGENT_CLI} Code and Cursor auto-detect it)"
  return 0
}

# ------------------------------------------------------------------ the brief --
# `gob init` with no --write: print the prompt + schema. This IS the product: the agent
# in the repo reads this output and does the work with its own tools.
print_brief() {
  cat <<'BRIEF'

== gob init — AGENT BRIEF ======================================================

You are the agent running inside this repository. gobstack is an AI-driven-development
harness: the CLI does not scan this repo — YOU do, with your own tools, and you report
back one proposal file. Do this now:

1. SCAN the repository:
   - package.json (scripts: dev/build/test/lint; package manager; framework deps)
   - routes and entry points (app/ or pages/ directories, routes/ dirs, *route* files)
   - the test layout (tests/, *.test.*, run-tests.sh or equivalent gate scripts)
   - CI configs (.github/workflows, .gitlab-ci.yml) — to READ what the project already
     gates on. gobstack installs no CI.

2. DECIDE, and be ready to justify each line:
   - gate_commit_cmd: ONE command that proves the repo is healthy and must stay green.
     RUN it yourself first: a command that does not exist is not a gate (--write refuses
     an exit-127 command); a command that runs and exits non-zero is a legitimate day-one
     red (--write accepts it and the harness reports it as one).
   - feature_map: the map's README path (the convention is features/README.md). REQUIRED —
     there is no "no map declared" state.

3. WRITE the proposal file exactly in the SCHEMA below, at a path you choose (for
   example .gob-init-proposal.md), then run:

       npx @techgoblin/gobstack init --write <proposal-path>

Notes:
   - A second gate is optional: gate_<name>_cmd, e.g. gate_todo_cmd.
   - Keys you do not set are filled from the installer's default block by --write.
   - --write validates BOTH halves in one pass: the config block AND the embedded feature
     map (FM-01 shape + FM-02 resolvability: every entry path exists AND is committed).
     A repo with no committed file to map REFUSES — commit at least one file, then run again.

== PROPOSAL SCHEMA =============================================================

<!-- gob:begin (gobstack config — edit in place; the parser reads only this block) -->
gate_<name>_cmd: <one shell command that must stay green>
feature_map: features/README.md
source_root: .
<!-- gob:end -->

## gob init summary

- <one bullet per decision: what you scanned, what you chose, why>
- <framework / package manager / test command found>

## feature-map

### features/README.md

```md
# Features

- [<slug>](./<slug>.md) — <one line>
```

### features/<slug>.md

```md
---
feature: <slug — lowercase [a-z0-9-], equals the filename stem>
entry_paths:
  - <repo-relative path that exists AND is committed (git ls-files)>
verified: never-driven (<today>)
---
# <slug>

<one user-visible paragraph, no implementation detail>

## Sub-features

- <the sub-behaviours, one per line>

## How to get to it (user POV)

- <how a user reaches this feature, and what they should see>

## Driving it with <harness>

Preconditions: <what must be true first>.
**<action>.** Run `<exact command>`. <the observable result.>

## Gotchas

- <what commonly breaks, or what the entry-path token does and does not prove>
```

(embed one `### <dir>/<slug>.md` block per feature; every feature must be linked from the
README index in the `(./<slug>.md)` form. `feature:` must equal the filename stem, and the
four H2s above are required, in order.)
============================================================================== ==
BRIEF
}

# The heuristic fallback: pre-scanned hints appended to the brief (--heuristic).
print_heuristic() {
  printf '\n== heuristic hints (--heuristic fallback — verify before trusting) ==\n\n'
  local got=0
  if [ -f "$TARGET/package.json" ]; then
    got=1
    printf 'package.json found. scripts:\n'
    awk 'BEGIN{d=0} /"scripts"/{d=1;next} d&&/}/{d=0} d&&/"[a-z]+":/{
      line=$0; sub(/^[[:space:]]*"/,"",line); sub(/".*/,"",line);
      print "  - " line }' "$TARGET/package.json" 2>/dev/null | head -n 12
    local pm
    [ -f "$TARGET/package-lock.json" ] && pm=npm
    [ -f "$TARGET/yarn.lock" ] && pm=yarn
    [ -f "$TARGET/pnpm-lock.yaml" ] && pm=pnpm
    [ -n "${pm:-}" ] && printf 'package manager: %s\n' "$pm"
  fi
  local d
  for d in app pages routes src; do
    [ -d "$TARGET/$d" ] && printf 'route/entry root candidate: %s/\n' "$d"
  done
  if [ "$got" -eq 0 ] && [ ! -d "$TARGET/src" ]; then
    printf 'no package.json, no src/ — the scan above is empty; say so in the summary\n'
  fi
  printf '\n'
}

# ------------------------------------------------------------------ the map -----
# Extract the proposal's `## feature-map` section. Each `### <path>` heading is followed
# by a fenced code block whose body is the file at <path> (repo-relative). Writes into
# <stage-dir>/<path> and prints the number of `### ` blocks found. This is the ONLY reader
# of the map half of the proposal; the SHAPE is then validated by bin/goblin-map (the same
# code path `gob map --write` used), never re-implemented here.
extract_feature_map() {  # <proposal> <stage-dir> -> block count on stdout
  local prop="$1" stage="$2" p
  # awk cannot mkdir: create every declared path's parent directory first.
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    mkdir -p "$stage/$(dirname "$p")" || return 1
  done < <(awk '
    /^```/ { fence = !fence; next }
    !inmap { if (!fence && $0 ~ /^##[[:space:]]+[Ff]eature-map[[:space:]]*$/) inmap=1; next }
    !fence {
      if ($0 ~ /^##[[:space:]]/) { inmap=0; next }
      if ($0 ~ /^###[[:space:]]+/) { p=$0; sub(/^###[[:space:]]+/,"",p); sub(/[[:space:]]+$/,"",p); print p }
    }
  ' "$prop")
  # then write the fenced-block bodies. Fence-aware: a feature file's own `## ` H2s and any
  # `### ` inside its fenced body are CONTENT, never the section's structure.
  awk -v stage="$stage" '
    function flush() { if (out != "") { close(out); out="" } }
    /^```/ { fence = !fence; next }
    !inmap { if (!fence && $0 ~ /^##[[:space:]]+[Ff]eature-map[[:space:]]*$/) inmap=1; next }
    !fence {
      if ($0 ~ /^##[[:space:]]/) { inmap=0; flush(); next }
      if ($0 ~ /^###[[:space:]]+/) {
        flush(); p=$0; sub(/^###[[:space:]]+/,"",p); sub(/[[:space:]]+$/,"",p)
        out = stage "/" p; n++; next
      }
      next
    }
    { if (out != "") print >> out }
    END { print n+0 }
  ' "$prop"
}

if [ -z "$WRITE" ]; then
  print_brief
  [ "$HEURISTIC" -eq 1 ] && print_heuristic
  g_info "== end of brief — the agent writes the proposal; gob init --write installs it =="
  exit 0
fi

# ----------------------------------------------------------------- validate ----
[ -f "$WRITE" ] || { g_err "proposal file not found: $WRITE"; exit 2; }
PROP=$(cd "$(dirname "$WRITE")" && pwd)/$(basename "$WRITE")
BLOCK_KEYS=$(g_agents_keys "$PROP")
[ -n "$BLOCK_KEYS" ] || { g_err "$PROP carries no gob block — the agent did not write the schema"; exit 2; }

# Unknown keys are refused: the proposal is machine-read, and a typo'd key would
# otherwise be silently ignored forever (fail closed, like --only does).
KNOWN_KEYS="practice practice_sha256 archive
max_dirty advisory_ceiling security.gitignore_family security.build_output
security.write_routes perf.metric perf.cmd perf.baseline_commit perf.baseline_value
perf.measured perf.host_gate harness_dir scaffold_checks feature_map source_root
verify_doctor reference_manifest quarantine_root
ratchet.name ratchet.cmd ratchet.ceiling runtime_data bans_disabled bans_exempt layers
replay.env replay.cmd replay.commit disabled engine_dir"
BAD_KEYS=""
# Token-by-token, not a whole-string case: KNOWN_KEYS is a multi-line word list and a
# `case` pattern cannot span the newlines.
while IFS= read -r k; do
  [ -n "$k" ] || continue
  case "$k" in gate_*_cmd) continue ;; esac
  found=""
  for known in $KNOWN_KEYS; do
    [ "$known" = "$k" ] && { found=1; break; }
  done
  [ -n "$found" ] || BAD_KEYS="$BAD_KEYS $k"
done <<< "$BLOCK_KEYS"
[ -z "$BAD_KEYS" ] || { g_err "$PROP names unknown key(s):$BAD_KEYS — fix or drop them"; exit 2; }

GATE_NAME=$(g_agents_gates "$PROP" | head -n 1 | awk -F'\t' '{print $1}')
GATE_CMD=$(g_agents_gates "$PROP" | head -n 1 | awk -F'\t' '{print $2}')
[ -n "$GATE_CMD" ] || { g_err "$PROP declares no gate — the brief requires at least one gate_<name>_cmd"; exit 2; }

# feature_map is REQUIRED (DECISION, 2026-10-09): the map is mandatory, so there is no
# "no map declared" state. A proposal without it, or with it empty, refuses here.
FEATURE_MAP=$(g_agents_read "$PROP" feature_map)
[ -n "$FEATURE_MAP" ] || { g_err "$PROP declares no feature_map — add 'feature_map: features/README.md' to the gob block and a '## feature-map' section (the brief's SCHEMA); the map is mandatory"; exit 2; }

# The map's directory, relative to the repo root. feature_map names the README (the value
# verify reads); the map lives in a directory of its own, never the repo root.
MAPDIR_REL=$(dirname "$FEATURE_MAP")
[ "$MAPDIR_REL" != "." ] || { g_err "feature_map must name a directory of its own (e.g. features/README.md), not the repo root"; exit 2; }

# Empty repo: no committed file to map. The map's entry paths are committed files, so a repo
# with nothing committed cannot carry a resolvable map. Refuse with the named remedy — no
# bootstrap feature is invented (a feature with no resolvable entry path is an assertion,
# not a count).
if [ -z "$( cd "$TARGET" && git ls-files 2>/dev/null | head -n 1 )" ]; then
  g_err "the target has no committed file to map — commit at least one file, then run again"; exit 2
fi

# Validate BOTH halves in ONE pass, before anything is written. The map the proposal embeds
# is extracted to a staging dir and handed to bin/goblin-map (the SAME validator `gob map
# --write` used): the FM-01 shape plus FM-02 resolvability (exists AND tracked) against the
# target. Nothing is written unless it validates.
STAGE=$(mktemp -d "${TMPDIR:-/tmp}/goblin-init.map.XXXXXX") || { g_err "mktemp failed"; exit 2; }
trap 'rm -rf "$STAGE"' EXIT
BLOCKS=$(extract_feature_map "$PROP" "$STAGE") || { g_err "could not read the proposal's feature-map section"; exit 2; }
[ "${BLOCKS:-0}" -ge 1 ] || { g_err "$PROP carries no feature-map blocks — the SCHEMA needs a '### $MAPDIR_REL/README.md' block and one '### $MAPDIR_REL/<slug>.md' per feature"; exit 2; }
[ -d "$STAGE/$MAPDIR_REL" ] || { g_err "the proposal's feature-map blocks are not under '$MAPDIR_REL' (the directory of the declared feature_map: $FEATURE_MAP)"; exit 2; }
if ! MAP_OUT=$(bash "$SRC/bin/goblin-map" --validate "$STAGE/$MAPDIR_REL" --root "$TARGET" 2>&1); then
  printf '%s\n' "$MAP_OUT" >&2
  g_err "the proposal's feature map failed validation (FM-01/FM-02) — fix the file(s) named above; nothing was written"
  exit 2
fi

if [ "$DRYRUN" -eq 1 ]; then
  g_info "gob init --write --dry-run: validated OK (1+ gate, feature map '$FEATURE_MAP')"
  g_info "  would write: AGENTS.md (body + gob block), .gob/engine/, HANDOFF.md, $MAPDIR_REL/"
  g_info "  the declared gate was NOT run (--dry-run)"
  exit 0
fi

# ------------------------------------------------------------------- the gate ---
# The gate is RUN, not guessed (DECISION, 2026-10-09). Execute the declared first gate in the
# working tree before installing, and report the measured exit code and the command's first
# output line. A non-zero exit is ACCEPTED — a legitimate day-one red that GT-02 re-runs from
# the installed config. A command that CANNOT be run at all (exit 127) is not a gate: refuse.
GATE_RAW=$( cd "$TARGET" && bash -c "$GATE_CMD" 2>&1 ); GATE_RC=$?
if [ "$GATE_RC" -eq 127 ]; then
  g_err "gate_${GATE_NAME}_cmd is not a runnable command (exit 127): $GATE_CMD — name a command that exists, or author one at checks/gate.sh"
  exit 2
fi
GATE_LINE=$(printf '%s\n' "$GATE_RAW" | sed '/^[[:space:]]*$/d' | head -n 1)
g_info "gob init [gate] $GATE_CMD"
g_info "  measured exit code: $GATE_RC"
if [ -n "$GATE_LINE" ]; then g_info "  first output line: $GATE_LINE"; fi

# ------------------------------------------------------------------- install ---
# One engine call writes the vendored payload (.gob/), AGENTS.md body + gob block and
# HANDOFF.md. Its refusal contract applies verbatim: an existing HANDOFF.md is never
# overwritten; an edited AGENTS.md body is kept (put_once) and only the block is rewritten.
INSTALL_ARGS=(--target "$TARGET" --skills no --yes)
# The first gate is the proposal's own: its name AND command. The name rides along so the
# HANDOFF template renders the declared name — HP-03 anchors on declared gate names, and a
# HANDOFF that names a gate the config does not declare is the day-one red (GT-04/HP-03
# anchoring). GATE_NAME comes from the same key the reader parses (gate_<name>_cmd).
GATE_NAME=$(g_agents_gates "$PROP" | head -n 1 | awk -F'\t' '{print $1}')
INSTALL_ARGS+=(--gate "$GATE_CMD" "$GATE_NAME")
printf 'gob init [run] goblin-install --target %s\n' "$TARGET"
# The engine is told to DEFER the next-steps block: this front-door command prints the ONE list
# itself, at the very end (g_next_block). Without this the user saw two `next:` lists.
GOB_NEXT_DEFER=1 bash "$SRC/bin/goblin-install" "${INSTALL_ARGS[@]}"
RC=$?
[ "$RC" -eq 0 ] || { g_err "install failed (exit $RC) — the refusals above name the path and the fix"; exit "$RC"; }

CONFIG="$TARGET/AGENTS.md"
[ -f "$CONFIG" ] || { g_err "install wrote no AGENTS.md at $TARGET"; exit 1; }

# The proposal MERGES over the defaults the installer rendered: the proposal's keys
# win, every default key the proposal did not set stays (a proposal carrying only the
# brief's required keys must not blank archive/ratchet/replay — the schema is a minimum,
# not the whole block). Proposal keys the config did not have are appended.
# EXCEPT the gate keys: the proposal's first gate REPLACES the installer's default gate_<name>_cmd
# (the default names a taxonomy gate the project never declared), and every OTHER
# default gate_* key is dropped — a gate the config declares must be one the proposal chose,
# never a leftover default naming a gate the HANDOFF does not render. The second default gate
# (the todo_ceiling) is opt-IN: the proposal may declare it itself.
{
  first_gate=1
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    case "$k" in gate_*_cmd)
      if [ "$first_gate" -eq 1 ]; then
        first_gate=0
        printf '%s\t%s\n' "$GATE_NAME" "$(g_agents_read "$PROP" "$k")" | awk -F'\t' '{ n=$1; c=$2; printf "gate_%s_cmd\t%s\n", n, c }'
      fi
      continue ;;
    esac
    # An ABSENT key prints "key<TAB><TAB>", which renders as "key:: key:" - a key that
    # reads back as its own name twice and fails IN-02/PF-01/FM-01 on a fresh install.
    # A proposal line with an empty value carries no merge information (the installer
    # default already covers it): drop it here.
    k_val=$(g_agents_read "$PROP" "$k")
    [ -n "$k_val" ] && printf '%s\t%s\n' "$k" "$k_val"
  done <<< "$BLOCK_KEYS"
  while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    printf '%s\n' "$BLOCK_KEYS" | grep -qxF "$k" && continue
    case "$k" in gate_*_cmd) continue ;; esac
    printf '%s\t%s\n' "$k" "$v"
  done < <(g_agents_pairs "$CONFIG")
} | g_agents_write "$CONFIG" >/dev/null || { g_err "could not write the gob block into $CONFIG"; exit 1; }

# Fail closed: the declared gate must read back through the engine's own reader.
GOT_GATE=$(g_agents_gates "$CONFIG" | head -n 1 | awk -F'\t' '{print $2}')
[ "$GOT_GATE" = "$GATE_CMD" ] || { g_err "the first gate did not land in $CONFIG (reader sees '$GOT_GATE', wanted '$GATE_CMD')"; exit 1; }
[ "$(g_agents_read "$CONFIG" feature_map)" = "$FEATURE_MAP" ] || { g_err "feature_map did not land in $CONFIG (reader sees '$(g_agents_read "$CONFIG" feature_map)', wanted '$FEATURE_MAP')"; exit 1; }

# --------------------------------------------------------------- feature map ----
# Materialise the map the proposal embedded (validated above, before anything was written).
mkdir -p "$TARGET/$MAPDIR_REL" || { g_err "could not create $TARGET/$MAPDIR_REL"; exit 1; }
cp -R "$STAGE/$MAPDIR_REL/." "$TARGET/$MAPDIR_REL/" 2>/dev/null \
  || { g_err "could not write the feature map into $TARGET/$MAPDIR_REL"; exit 1; }
[ -f "$TARGET/$FEATURE_MAP" ] || { g_err "the feature map did not land at $TARGET/$FEATURE_MAP"; exit 1; }

# ------------------------------------------------------------- mcp config ------
# The user runs NO gob command after install: --write registers the gob MCP server
# itself (ask-once; a customized .mcp.json is kept, never overwritten).
do_mcp_config || exit 1

# --------------------------------------------------------------------- done ----
printf '\n'
printf 'gob init: installed — feature map %s\n' "$FEATURE_MAP"
printf '  harness: %s/.gob/bin/goblin-verify\n' "$TARGET"
printf '\n'
# The ONE ordered next-steps list (the engine deferred its own copy). The gate is the one this
# command declared and MEASURED above, so the list does not tell the user to replace it.
g_next_block "$TARGET" no "$GATE_NAME: $GATE_CMD"
exit 0
