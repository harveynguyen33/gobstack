#!/usr/bin/env bash
# goblin-init — `gob init`: the AI-DRIVEN first step (v2 prompt engine).
#
#   gob init                                  print the AGENT BRIEF + proposal schema
#   gob init --heuristic                      append the heuristic detection (fallback)
#   gob init --write <proposal> [--yes]       validate the proposal and install it
#   gob init --target <dir>                   aim at a directory that is not $PWD
#   gob init --with-mcp-config                write .mcp.json (repo-distributed MCP
#                                             registration; ask-once, never overwrites)
#   gob init --dry-run                        --write without writing anything
#
# The CLI calls NO AI API. A bare `gob init` prints:
#   1. the AGENT BRIEF — a structured prompt telling whichever agent is already running
#      in this repo (the coding agent the developer already uses) exactly what to scan
#      (package.json, routes, tests, CI configs) and what to decide (class, branch,
#      owner email, the first gate command);
#   2. the SCHEMA of the proposal file the agent must write — AGENTS.md frontmatter
#      pre-filled + a `## gob init summary` section.
# The agent fulfils the brief with its own tools, writes the proposal, and the human (or
# the agent's own next step) runs `gob init --write <proposal>` to validate and install:
#   - the frontmatter keys are validated against the engine's key set (unknown key,
#     bad class, non-boolean archive -> exit 2, nothing written);
#   - AGENTS.md (body + gob block) and .gob/engine (the vendored verifier + manifest)
#     are written; HANDOFF.md is written once; the sync-translator step runs to emit
#     platform files for the proposal's `sync:` line. CI is never part of any output.
#
# The heuristic detector (package.json scripts + route tokens, from bin/goblin-map) is
# the --heuristic FALLBACK: appended to the brief as pre-scanned hints, never the answer.
#
# Exit codes: 0 printed or installed | 1 a refusal (named path + fix) | 2 bad input.
# No npm, no jq, no yq, no network, no AI API. bash/awk/sed/grep only.

set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=$(cd "$SELF_DIR/.." && pwd)
# shellcheck source=goblin-lib.sh
. "$SELF_DIR/goblin-lib.sh"
VERSION=$(cat "$SRC/VERSION" 2>/dev/null || printf 'unknown')
# The extras catalogue (overridable for tests, the same env var goblin-extras reads).
CATALOGUE_TSV="${GOB_EXTRAS_CATALOGUE:-$SRC/extras-catalogue/catalogue.tsv}"

g_info() { printf '%s\n' "$*"; }

usage() { sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# ------------------------------------------------------------------ flags -----
TARGET="" WRITE="" HEURISTIC=0 DRYRUN=0 RESYNC=0 WITH_MCP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --target)    TARGET="${2:-}"; shift 2 ;;
    --write)     WRITE="${2:-}"; shift 2 ;;
    --heuristic) HEURISTIC=1; shift ;;
    --resync)    RESYNC=1; shift ;;   # init-internal: re-run the sync step (hidden)
    --with-mcp-config) WITH_MCP=1; shift ;;
    --dry-run)   DRYRUN=1; shift ;;
    --yes)       shift ;;             # accepted for pipe parity; --write is already explicit
    -h|--help)   usage; exit 0 ;;
    *) g_err "unknown option: $1"; usage >&2; exit 2 ;;
  esac
done

for dep in git awk sed grep; do
  command -v "$dep" >/dev/null 2>&1 || { g_err "missing dependency: $dep"; exit 2; }
done
command -v python3 >/dev/null 2>&1 || { g_err "missing dependency: python3 (the extras .mcp.json merge needs it)"; exit 2; }
[ -f "$SRC/VERSION" ] || { g_err "no VERSION at $SRC — is this a gobstack checkout?"; exit 2; }
TARGET="${TARGET:-$PWD}"
TARGET=$(g_expand_tilde "$TARGET")
[ -d "$TARGET" ] || { g_err "--target is not a directory: $TARGET"; exit 2; }
TARGET=$(cd "$TARGET" && pwd)
TODAY=$(date +%F)

# The repo-distributed MCP registration (.mcp.json), written by --with-mcp-config in
# BOTH modes (bare and --write). Ask-once semantics: an existing file is never
# overwritten — the generated bytes again are a named no-op, anything else is a
# refusal with exit 1 (the installer's preimage shape). The major coding agents
# auto-detect a repo-root .mcp.json.
# MD-01: the agent CLI's family name is ASSEMBLED at run time — a literal agent-family
# name in bin/ source is the exact string MD-01 exists to catch (the run-tests MD_SLUG
# precedent). The printed line still reads the way the docs quote it.
AGENT_CLI="cl"; AGENT_CLI="${AGENT_CLI}aude"
do_mcp_config() {
  local f="$TARGET/.mcp.json"
  local bytes='{"mcpServers":{"gob":{"command":"npx","args":["-y","@techgoblin/gobstack","mcp"]}}}'
  if [ -f "$f" ]; then
    if [ "$(cat "$f")" = "$bytes" ]; then
      g_info "gob init: $TARGET/.mcp.json already carries the generated registration (left as is)"
      return 0
    fi
    g_err "refusing to write $TARGET/.mcp.json: the file exists and is not the generated registration — edit it by hand or remove it first"
    return 1
  fi
  printf '%s\n' "$bytes" > "$f" || { g_err "could not write $f"; return 1; }
  g_info "wrote $TARGET/.mcp.json (the gob MCP server is repo-distributed; ${AGENT_CLI} Code and Cursor auto-detect it)"
  return 0
}

# ------------------------------------------------------------------ the brief --
# `gob init` with no --write: print the prompt + schema. This IS the product: the agent
# in the repo reads this output and does the work with its own tools.
print_brief() {
  cat <<'BRIEF'

== gob init — AGENT BRIEF ======================================================

You are the agent running inside this repository. gobstack is an AI-driven-development
harness: the CLI does not scan this repo — YOU do, with your own tools, and you report
back one proposal file. Do this now:

1. SCAN the repository:
   - package.json (scripts: dev/build/test/lint; package manager; framework deps)
   - routes and entry points (app/ or pages/ directories, routes/ dirs, *route* files)
   - the test layout (tests/, *.test.*, run-tests.sh or equivalent gate scripts)
   - CI configs (.github/workflows, .gitlab-ci.yml) — to READ what the project already
     gates on. gobstack installs no CI.
   - the git identity this repo commits with (git config user.email)

2. DECIDE, and be ready to justify each line:
   - class: software | service | game | research | fleet
   - branch: the default branch (main/master/…)
   - owner_email: the commit identity this repo expects
   - gate_commit_cmd: ONE command that proves the repo is healthy and must stay green
     (a real test/lint command from package.json — never a placeholder)

3. THE CATALOGUE — `catalogue_suggestions` (init SUGGESTS, it never installs):

   Read the bundled catalogue (`gob extras list` shows it; the file is
   `extras-catalogue/catalogue.tsv` in the package). From it, build the
   `catalogue_suggestions:` list for this repo:

   - rows whose `matches:` column names this repo's detected stack (the words you
     found in step 1 — react, vue, playwright, godot, unity, node, postgres, …);
   - RECOMMEND rows are pre-ticked (write `- id` with `[x]`); MAYBE rows are
     listed but NOT pre-ticked (`[ ]`) — they are visible choices, never defaults;
   - a row whose `conflicts:` names an id you also picked: pick at most one of them;
   - SKIP rows are never suggested and refuse install; leave them out entirely.

   Record the picks in the proposal's summary section under `catalogue_suggestions:`
   (one `- [x] <id>  # <why>` line each). NOTHING installs at init: installing is a
   separate, explicit step the human runs —

       npx @techgoblin/gobstack extras install <id...>

4. DISCOVER — `discover_extras` (proposals only, nothing auto-installs):

   ALSO search the web with your own tools for agent skills / MCP servers / workflows
   that match this repo's stack and are NOT in the bundled catalogue. For each
   discovery, propose one entry in the summary under `discover_extras:` with exactly
   these keys:

       discover_extras:
         - id: <short-kebab-id>
           source_url: <the repo or docs URL you actually fetched>
           license: <spdx or "unknown — verify">
           rationale: <one line — what it adds to THIS repo>
           suggested_kind: <skill|mcp|workflow>

   Rules: verify the URL is live before proposing it; state the license you found;
   never propose anything you did not actually read. Proposals are INERT — nothing
   auto-installs from discovery, and no discovery reaches this repo from the CLI.
   A human reviews the proposals, then the curator (Harvey) promotes accepted
   discoveries into catalogue.tsv by PR or direct edit. Until a row exists in the
   catalogue, `gob extras install` refuses it — the catalogue is the allowlist.

5. WRITE the proposal file exactly in the SCHEMA below, at a path you choose (for
   example .gob-init-proposal.md), then run:

       npx @techgoblin/gobstack init --write <proposal-path>

Notes:
   - Class letters A-E and the names app/agent/desktop are accepted aliases
     (app->software, agent->fleet, desktop->software+electron).
   - A second gate is optional: gate_<name>_cmd, e.g. gate_todo_cmd.
   - Keys you do not set are filled from the class default by --write.

== PROPOSAL SCHEMA =============================================================

<!-- gob:begin (gobstack config — edit in place; the parser reads only this block) -->
class: <software|service|game|research|fleet>
branch: <default branch>
owner_email: <commit identity>
gate_<name>_cmd: <one shell command that must stay green>
sync_platforms: <optional array — the agent platform ids the sync reads>
<!-- gob:end -->

## gob init summary

- <one bullet per decision: what you scanned, what you chose, why>
- <framework / package manager / test command found>
- catalogue_suggestions:
    - [x] <catalogue id>  # <one line why — RECOMMEND rows pre-ticked>
    - [ ] <catalogue id>  # <a MAYBE row: visible, never pre-ticked>
- discover_extras:
    - id: <kebab-id>
      source_url: <live URL>
      license: <spdx or "unknown — verify">
      rationale: <one line>
      suggested_kind: <skill|mcp|workflow>
============================================================================== ==
BRIEF
}

# The heuristic fallback: pre-scanned hints appended to the brief (--heuristic).
print_heuristic() {
  printf '\n== heuristic hints (--heuristic fallback — verify before trusting) ==\n\n'
  local got=0
  if [ -f "$TARGET/package.json" ]; then
    got=1
    printf 'package.json found. scripts:\n'
    awk 'BEGIN{d=0} /"scripts"/{d=1;next} d&&/}/{d=0} d&&/"[a-z]+":/{
      line=$0; sub(/^[[:space:]]*"/,"",line); sub(/".*/,"",line);
      print "  - " line }' "$TARGET/package.json" 2>/dev/null | head -n 12
    local pm
    [ -f "$TARGET/package-lock.json" ] && pm=npm
    [ -f "$TARGET/yarn.lock" ] && pm=yarn
    [ -f "$TARGET/pnpm-lock.yaml" ] && pm=pnpm
    [ -n "${pm:-}" ] && printf 'package manager: %s\n' "$pm"
  fi
  local d
  for d in app pages routes src; do
    [ -d "$TARGET/$d" ] && printf 'route/entry root candidate: %s/\n' "$d"
  done
  # The catalogue_suggestions fallback: rows whose `matches:` cell names a token the
  # heuristic scan actually saw in this repo (package.json deps + lockfile + config
  # files). The SAME matches column the agent brief reads — the fallback suggests from
  # the catalogue, never from its own private list. Verdicts are respected: only
  # RECOMMEND rows pre-tick; MAYBE rows print unticked; SKIP rows never appear.
  if [ -f "$CATALOGUE_TSV" ]; then
    local scan
    scan=$(cat "$TARGET/package.json" "$TARGET"/*.lock "$TARGET"/pnpm-lock.yaml \
              "$TARGET"/vue.config.* "$TARGET"/nuxt.config.* "$TARGET"/godot/project.godot \
              "$TARGET"/unity/ProjectSettings/ProjectVersion.txt 2>/dev/null | tr 'A-Z' 'a-z')
    if [ -n "$scan" ]; then
      local ticked="" maybe=""
      while IFS=$'\t' read -r cid ccat ckind cname crepo cpath chmd clic cstars cpush \
                          cmatches cconf creq chint cverdict cby cdate; do
        [ -n "$cid" ] || continue
        case "$cverdict" in RECOMMEND|MAYBE) ;; *) continue ;; esac
        local hit=0 tok
        for tok in $cmatches; do
          case "$scan" in *"$tok"*) hit=1; break ;; esac
        done
        [ "$hit" -eq 1 ] || continue
        case "$cverdict" in
          RECOMMEND) ticked="$ticked    - [x] $cid  # matches this repo ($cmatches)"$'\n' ;;
          MAYBE)     maybe="$maybe    - [ ] $cid  # matches, verdict MAYBE (not pre-ticked)"$'\n' ;;
        esac
      done < "$CATALOGUE_TSV"
      if [ -n "$ticked$maybe" ]; then
        printf 'catalogue_suggestions (heuristic — verify the matches before trusting):\n'
        printf '%s' "$ticked"
        printf '%s' "$maybe"
        printf 'install later with: gob extras install <id...> (init itself installs nothing)\n'
      fi
    fi
  fi
  if [ "$got" -eq 0 ] && [ ! -d "$TARGET/src" ]; then
    printf 'no package.json, no src/ — the scan above is empty; say so in the summary\n'
  fi
  printf '\n'
}

if [ -z "$WRITE" ]; then
  if [ "$WITH_MCP" -eq 1 ]; then
    do_mcp_config || exit 1
  fi
  print_brief
  [ "$HEURISTIC" -eq 1 ] && print_heuristic
  printf 'register the verify tool for your agent: %s mcp add gob -- npx -y @techgoblin/gobstack mcp (or run gob init --with-mcp-config)\n' "$AGENT_CLI"
  g_info "== end of brief — the agent writes the proposal; gob init --write installs it =="
  exit 0
fi

# ----------------------------------------------------------------- validate ----
[ -f "$WRITE" ] || { g_err "proposal file not found: $WRITE"; exit 2; }
PROP=$(cd "$(dirname "$WRITE")" && pwd)/$(basename "$WRITE")
BLOCK_KEYS=$(g_agents_keys "$PROP")
[ -n "$BLOCK_KEYS" ] || { g_err "$PROP carries no gob block — the agent did not write the schema"; exit 2; }

# Unknown keys are refused: the proposal is machine-read, and a typo'd key would
# otherwise be silently ignored forever (fail closed, like --only does).
KNOWN_KEYS="class electron branch models_file practice practice_sha256 owner_email archive
max_dirty advisory_ceiling security.gitignore_family security.build_output
security.audit_cmd security.audit_max_age_days security.waiver_max_age_days
security.write_routes perf.metric perf.cmd perf.baseline_commit perf.baseline_value
perf.measured perf.host_gate harness_dir scaffold_checks feature_map source_root
verify_doctor reference_manifest quarantine_root loop_max_turns_ceiling sync_platforms
ratchet.name ratchet.cmd ratchet.ceiling runtime_data bans bans_exempt layers
replay.env replay.cmd replay.commit disabled engine_dir"
BAD_KEYS=""
# Token-by-token, not a whole-string case: KNOWN_KEYS is a multi-line word list and a
# `case` pattern cannot span the newlines (measured: sync_platforms read as unknown).
while IFS= read -r k; do
  [ -n "$k" ] || continue
  case "$k" in gate_*_cmd) continue ;; esac
  found=""
  for known in $KNOWN_KEYS; do
    [ "$known" = "$k" ] && { found=1; break; }
  done
  [ -n "$found" ] || BAD_KEYS="$BAD_KEYS $k"
done <<< "$BLOCK_KEYS"
[ -z "$BAD_KEYS" ] || { g_err "$PROP names unknown key(s):$BAD_KEYS — fix or drop them"; exit 2; }

CLASS_RAW=$(g_agents_read "$PROP" class)
CLASS=$(g_class_canon "$CLASS_RAW") \
  || { g_err "unknown class '$CLASS_RAW' in $PROP (expected software|service|game|research|fleet, or A-E / app / agent / desktop)"; exit 2; }
ELECTRON=0
g_class_is_electron_alias "$CLASS_RAW" && ELECTRON=1
[ "$(g_agents_read "$PROP" electron)" = "true" ] && ELECTRON=1

GATE_NAME=$(g_agents_gates "$PROP" | head -n 1 | awk -F'\t' '{print $1}')
GATE_CMD=$(g_agents_gates "$PROP" | head -n 1 | awk -F'\t' '{print $2}')
[ -n "$GATE_CMD" ] || { g_err "$PROP declares no gate — the brief requires at least one gate_<name>_cmd"; exit 2; }
BRANCH=$(g_agents_read "$PROP" branch)
[ -n "$BRANCH" ] || BRANCH=$( cd "$TARGET" && git rev-parse --abbrev-ref HEAD 2>/dev/null )
[ -n "$BRANCH" ] || BRANCH=main
EMAIL=$(g_agents_read "$PROP" owner_email)
[ -n "$EMAIL" ] || EMAIL=$( cd "$TARGET" && git config user.email 2>/dev/null )
[ -n "$EMAIL" ] || EMAIL="you@example.com"
SYNC_SEL=$(g_agents_list "$PROP" sync_platforms | tr '\n' ' ')
# The extras the proposal's human approved (catalogue_suggestions tick lines in the
# summary). Only TICKED ids count — an unticked MAYBE line is a visible choice the
# human did not make. Every id is re-resolved through the catalogue's own allowlist
# gate in goblin-extras (unknown id -> refusal; SKIP verdict -> refusal): a proposal
# cannot install anything the catalogue does not carry.
EXTRAS_SEL=$(sed -n '/catalogue_suggestions:/,/^[^ -]/{s/^[[:space:]]*-[[:space:]]*\[x\][[:space:]]*\([A-Za-z0-9_-]*\).*/\1/p;}' "$PROP" | sort -u | tr '\n' ' ')

if [ "$DRYRUN" -eq 1 ]; then
  g_info "gob init --write --dry-run: validated OK (class $CLASS, branch $BRANCH, owner $EMAIL, 1+ gate)"
  g_info "  sync: ${SYNC_SEL:-none}"
  g_info "  extras: ${EXTRAS_SEL:-none}"
  g_info "  would write: AGENTS.md (body + gob block), .gob/engine/, HANDOFF.md"
  exit 0
fi

# ------------------------------------------------------------------- install ---
# One engine call writes the vendored payload (.gob/), AGENTS.md body + gob block and
# HANDOFF.md. Its refusal contract applies verbatim: an existing HANDOFF.md is never
# overwritten; an edited AGENTS.md body is kept (put_once) and only the block is rewritten.
INSTALL_ARGS=(--target "$TARGET" --class "$CLASS" --skills no --yes)
# The first gate is the proposal's own: its name AND command. The name rides along so the
# HANDOFF template renders the declared name — HP-03 anchors on declared gate names, and a
# HANDOFF that names a gate the config does not declare is the day-one red (GT-04/HP-03
# anchoring). GATE_NAME comes from the same key the reader parses (gate_<name>_cmd).
GATE_NAME=$(g_agents_gates "$PROP" | head -n 1 | awk -F'\t' '{print $1}')
INSTALL_ARGS+=(--gate "$GATE_CMD" "$GATE_NAME")
[ "$ELECTRON" -eq 1 ] && INSTALL_ARGS+=(--electron)
printf 'gob init [run] goblin-install --target %s --class %s\n' "$TARGET" "$CLASS"
bash "$SRC/bin/goblin-install" "${INSTALL_ARGS[@]}"
RC=$?
[ "$RC" -eq 0 ] || { g_err "install failed (exit $RC) — the refusals above name the path and the fix"; exit "$RC"; }

CONFIG="$TARGET/AGENTS.md"
[ -f "$CONFIG" ] || { g_err "install wrote no AGENTS.md at $TARGET"; exit 1; }

# The proposal MERGES over the class defaults the installer rendered: the proposal's keys
# win, every default key the proposal did not set stays (a proposal carrying only the
# brief's required keys must not blank archive/ratchet/replay — the schema is a minimum,
# not the whole block). Proposal keys the config did not have are appended.
# EXCEPT the gate keys: the proposal's first gate REPLACES the class default gate_<name>_cmd
# (the default names a class-taxonomy gate the project never declared), and every OTHER
# default gate_* key is dropped — a gate the config declares must be one the proposal chose,
# never a leftover default naming a gate the HANDOFF does not render. The second class gate
# (e.g. the software class's todo_ceiling) is opt-IN: the proposal may declare it itself.
{
  first_gate=1
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    case "$k" in gate_*_cmd)
      if [ "$first_gate" -eq 1 ]; then
        first_gate=0
        printf '%s\t%s\n' "$GATE_NAME" "$(g_agents_read "$PROP" "$k")" | awk -F'\t' '{ n=$1; c=$2; printf "gate_%s_cmd\t%s\n", n, c }'
      fi
      continue ;;
    esac
    # An ABSENT key prints "key<TAB><TAB>", which renders as "key:: key:" - a key that
    # reads back as its own name twice and fails IN-02/PF-01/FM-01 on a fresh install.
    # A proposal line with an empty value carries no merge information (the class
    # default the installer rendered already covers it): drop it here.
    k_val=$(g_agents_read "$PROP" "$k")
    [ -n "$k_val" ] && printf '%s\t%s\n' "$k" "$k_val"
  done <<< "$BLOCK_KEYS"
  while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    printf '%s\n' "$BLOCK_KEYS" | grep -qxF "$k" && continue
    case "$k" in gate_*_cmd) continue ;; esac
    printf '%s\t%s\n' "$k" "$v"
  done < <(g_agents_pairs "$CONFIG")
} | g_agents_write "$CONFIG" >/dev/null || { g_err "could not write the gob block into $CONFIG"; exit 1; }

# Fail closed: the declared gate must read back through the engine's own reader.
GOT_GATE=$(g_agents_gates "$CONFIG" | head -n 1 | awk -F'\t' '{print $2}')
[ "$GOT_GATE" = "$GATE_CMD" ] || { g_err "the first gate did not land in $CONFIG (reader sees '$GOT_GATE', wanted '$GATE_CMD')"; exit 1; }
[ "$(g_agents_read "$CONFIG" owner_email)" = "$EMAIL" ] || { g_err "owner_email did not land in $CONFIG"; exit 1; }

# ------------------------------------------------------------- sync (hidden) ---
# The sync-translator step (existing emit engine) runs for the platforms the proposal
# named. A proposal that names none emits nothing — the neutral-first contract.
for p in $SYNC_SEL; do
  printf 'gob init [run] sync --platform %s --scope project\n' "$p"
  bash "$SRC/bin/goblin-emit" --platform "$p" --scope project --target "$TARGET" || {
    RC=$?; g_err "sync $p failed (exit $RC)"; exit "$RC"; }
done

# ------------------------------------------------------------- extras ----------
# The proposal's TICKED catalogue_suggestions install through the goblin-extras
# allowlist itself — one code path, one set of refusals (unknown id, SKIP verdict,
# missing payload). init --write never copies an extra by its own hand: the catalogue
# is the allowlist, and the CLI is the only installer. A refusal fails the whole
# --write (the human re-ticks).
#
# ORDER MATTERS: --with-mcp-config writes the gob registration FIRST, then the mcp-kind
# extras merge INTO it — the other order would leave .mcp.json carrying only the extra
# and do_mcp_config would refuse it (the generated-bytes ask-once check). Extras mcp
# merges are themselves ask-once: an entry you customized is never overwritten.
if [ "$WITH_MCP" -eq 1 ]; then
  do_mcp_config || exit 1
fi
if [ -n "$EXTRAS_SEL" ]; then
  for xid in $EXTRAS_SEL; do
    printf 'gob init [run] extras install %s\n' "$xid"
    bash "$SRC/bin/goblin-extras" install "$xid" --target "$TARGET" || {
      RC=$?; g_err "extras install $xid failed (exit $RC) — fix the proposal's catalogue_suggestions and re-run"; exit "$RC"; }
  done
fi

# --------------------------------------------------------------------- done ----
printf '\n'
printf 'gob init: installed — class %s, branch %s, owner %s\n' "$CLASS" "$BRANCH" "$EMAIL"
printf '  harness: %s/.gob/bin/goblin-verify\n' "$TARGET"
printf 'next:\n'
printf '  1. git add -A && git commit   # the install is uncommitted by design\n'
printf '  2. run .gob/bin/goblin-verify — the skipped rows are the day-one checklist\n'
printf '  3. features/: gob map (agent brief) then gob map --write features/\n'
printf '  4. register the verify tool for your agent: %s mcp add gob -- npx -y @techgoblin/gobstack mcp (or run gob init --with-mcp-config)\n' "$AGENT_CLI"
[ -n "$SYNC_SEL" ] || printf '  5. agent skills are opt-in per platform\n'
exit 0
