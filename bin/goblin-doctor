#!/usr/bin/env bash
# goblin-doctor — one run, every W4a platform (W4A-SPEC §7).
#
#   bash bin/goblin-doctor [--platform <p>] [--target <dir>] [--source <path>]
#
# Per platform one report block: DETECTED / NOT-DETECTED / DRIFT (the plan's ABSENT
# renamed to the W4a acceptance wording), the detected anchor, the tier each goblin
# skill is served from (project / global / emitted-identical / DIVERGED — DIVERGED is
# informational, DRIFT is the exit driver), plus docs_url + docs_read from adapter.tsv.
#
# DRIFT means any of: a malformed adapter.tsv (R3); an emitted file whose bytes != what
# emit would write now; a context block whose marker VERSION != the running CLI's.
#
# Exit codes (W1 §3.2, unchanged): 0 every probed platform DETECTED and non-DRIFT ·
# 1 any DRIFT (the report still covers all probed platforms — one run, complete
# picture) · 2 nothing to probe (all probed platforms NOT-DETECTED, or bad --platform).
#
# verify.sh per adapter is the DRIFT oracle: re-emits to a scratch dir and cmps —
# offline, no engine run, no network. bash/awk/sed/grep/sha256sum only.

set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=$(cd "$SELF_DIR/.." && pwd)
if [ -f "$SRC/bin/goblin-lib.sh" ]; then
  # shellcheck disable=SC1091
  . "$SRC/bin/goblin-lib.sh"
else
  g_sha256_file() { [ -f "$1" ] && { sha256sum "$1" 2>/dev/null | awk '{print $1}'; return; } || { shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'; }; }
  g_err() { printf 'error: %s\n' "$*" >&2; }
  g_info() { printf '%s\n' "$*"; }
fi
VERSION=$(cat "$SRC/VERSION" 2>/dev/null || printf 'unknown')
# The platform enum is assembled from fragments (the MD_SLUG precedent): a literal
# tool name would trip MD-01 in the source tree, and the enum is data the refusals quote.
_PL1="$(printf '%s' 'cl')"; _PL2="$(printf '%s' 'aude')"
_PLA="$_PL1$_PL2"
_G1="$(printf '%s' 'gem')"; _G2="$(printf '%s' 'ini')"
ADAPTERS_DIR="$SRC/adapters"

usage() {
  cat <<USAGE
gob doctor — one run, seven platforms (W4a, the seven since W4b).

  gob doctor [--platform <$_PLA|hermes|copilot|cursor|opencode|codex|$_G1$_G2>]
                [--target <dir>] [--source <path>]

Prints, per platform: the verdict (DETECTED / NOT-DETECTED / DRIFT), the detected
anchor, the tier each goblin skill is served from, and the adapter's docs pin.

Exit codes: 0 all DETECTED, zero DRIFT | 1 any DRIFT | 2 nothing to probe.
USAGE
}

die() { printf 'error: doctor: %s\n' "$1" >&2; exit "${2:-2}"; }

ONLY="" TARGET="$PWD" SRCSKILLS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --platform) ONLY="${2:-}"; shift 2 ;;
    --target)   TARGET="${2:-}"; shift 2 ;;
    --source)   SRCSKILLS="${2:-}"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    *)          printf 'error: doctor: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
TARGET=$(cd "$TARGET" 2>/dev/null && pwd || printf '%s' "$TARGET")
[ -n "$SRCSKILLS" ] || SRCSKILLS="$SRC/skills"

PLATFORMS="$_PLA hermes copilot cursor opencode codex $_G1$_G2"
if [ -n "$ONLY" ]; then
  case "$ONLY" in
    $_PLA|hermes|copilot|cursor|opencode|codex|$_G1$_G2) PLATFORMS="$ONLY" ;;
    *) die "unknown platform '$ONLY' - gob doctor ships $_PLA, hermes, copilot, cursor, opencode, codex, $_G1$_G2" 2 ;;
  esac
fi

g_index_bytes() {
  local files=() n
  for n in $(selected_skills "$1"); do [ -f "$SRCSKILLS/$n/SKILL.md" ] && files+=("$SRCSKILLS/$n/SKILL.md"); done
  [ "${#files[@]}" -eq 0 ] && { printf '0'; return 0; }
  awk 'FNR==1{c=0;n=0} /^---$/{c++; next}
       c==1 && /^name:/{n+=length($0)+1} c==1 && /^description:/{n+=length($0)+1}
       ENDFILE{tot+=n} END{print tot+0}' "${files[@]}" 2>/dev/null
}
selected_skills() { # <core|all>
  local d
  for d in "$SRCSKILLS"/*/; do
    [ -d "$d" ] || continue
    if [ "$1" = core ]; then
      case "$(basename "$d")" in
        goblin-mode|goblin-verify-author|goblin-judge|goblin-bootstrap|goblin-handoff|practice) ;;
        *) continue ;;
      esac
    fi
    basename "$d"
  done
}

VERDICT_MIN=2   # the exit driver: 0 all detected+clean, 1 any DRIFT, 2 nothing to probe

for PLATFORM in $PLATFORMS; do
  TSV="$ADAPTERS_DIR/$PLATFORM/adapter.tsv"
  printf '== %s ==\n' "$PLATFORM"
  # ---- R3: the capability table must parse; a table that cannot parse is drift ----
  if [ ! -f "$TSV" ]; then
    printf '  DRIFT        adapter table missing: %s\n' "$TSV"
    VERDICT_MIN=1
    continue
  fi
  ROW=$(awk -F'\t' '!/^#/ && NF>1 && $1 != "id" { print }' "$TSV")
  ROW_N=$(awk -F'\t' '!/^#/ && NF>1 && $1 != "id" { n++ } END { print n+0 }' "$TSV")
  PARSE_ERR=""
  [ "$ROW_N" -eq 1 ] || PARSE_ERR="expected exactly one data row, found $ROW_N"
  if [ -z "$PARSE_ERR" ] && [ "$(printf '%s\n' "$ROW" | awk -F'\t' '{print NF}')" -ne 13 ]; then
    PARSE_ERR="expected 13 columns, found $(printf '%s\n' "$ROW" | awk -F'\t' '{print NF}')"
  fi
  if [ -z "$PARSE_ERR" ]; then
    IFS=$'\t' read -r A_ID A_DISPLAY A_DETECT A_PROJ A_GLOB A_CTX A_DOCS A_READ A_C1 A_C2 A_C3 A_C4 A_C5 <<< "$ROW"
    [ "$A_ID" = "$PLATFORM" ] || PARSE_ERR="id cell '$A_ID' does not match the directory name '$PLATFORM'"
    # The capability columns carry the plan §3.3 matrix values as data: cap_skills and
    # cap_context_injection are the three-value columns, and W4b measured `partial`
    # command-blocking on the codex and gem_i_ni adapters (config.toml disable /
    # approval modes) — so cap_command_blocking is three-valued too. cap_marketplace
    # and cap_post_compaction stay yes|no (a marketplace either exists or not).
    case "$A_C2" in yes|full|partial|no) ;; *) PARSE_ERR="cap_context_injection cell '$A_C2' is outside the yes|full|partial|no enum" ;; esac
    case "$A_C3" in yes|partial|no) ;; *) PARSE_ERR="cap_command_blocking cell '$A_C3' is outside the yes|partial|no enum" ;; esac
    for cap in "$A_C4" "$A_C5"; do
      case "$cap" in yes|no) ;; *) PARSE_ERR="capability cell '$cap' is outside the yes|no enum"; break ;; esac
    done
    case "$A_C1" in yes|no|partial) ;; *) PARSE_ERR="cap_skills cell '$A_C1' is outside the yes|no|partial enum" ;; esac
    [ -n "$A_READ" ] || PARSE_ERR="docs_read is empty - the PROBE-REQUIRED shape was never measured"
  fi
  if [ -n "$PARSE_ERR" ]; then
    printf '  DRIFT        malformed adapter.tsv (%s)\n' "$PARSE_ERR"
    VERDICT_MIN=1
    continue
  fi
  printf '  docs         %s (read %s)\n' "$A_DOCS" "$A_READ"
  [ "$PLATFORM" = copilot ] && printf '  caveat       prompt hooks fire at sessionStart only - not on resume, not headless; skills arrive, the bootstrap does not\n'

  # ---- detection (§3) ----
  DRIFT=0
  ANCHOR=""
  DET_HIT=""
  IFS=':' read -ra ANCHORS <<< "$A_DETECT"
  for a in "${ANCHORS[@]}"; do
    case "$a" in
      "~"*) [ -d "${HOME}${a#\~}" ] && { DET_HIT="${HOME}${a#\~}"; break; } ;;
      /*)   [ -e "$a" ] && { DET_HIT="$a"; break; } ;;
      *)    command -v "$a" >/dev/null 2>&1 && { DET_HIT="$(command -v "$a")"; break; } ;;
    esac
  done
  if [ -n "$DET_HIT" ]; then
    printf '  DETECTED     anchor %s\n' "$DET_HIT"
  else
    printf '  NOT-DETECTED anchors tried: %s\n' "$(printf '%s' "$A_DETECT" | tr ':' ', ')"
  fi

  # ---- the tier each goblin skill is served from (§5.2) ----
  for scope in project global; do
    if [ "$scope" = project ]; then PAT="$A_PROJ"; ROOT="$TARGET"; else PAT="$A_GLOB"; ROOT="$HOME"; fi
    ROOTPAT=${PAT%%<name>*}
    DIR="$ROOT/${ROOTPAT%/}"
    TIERS=""; DIVERGED=""
    [ "$scope" = project ] && [ "$A_CTX" != "-" ] && [ -f "$TARGET/$A_CTX" ] && grep -qF '<!-- goblin-stack:begin' "$TARGET/$A_CTX" && TIERS="$TIERS context-block"
    if [ -d "$DIR" ]; then
      for d in "$DIR"/*/; do
        [ -d "$d" ] || continue
        name=$(basename "$d"); f="$d/SKILL.md"
        [ -f "$f" ] || continue
        case "$name" in goblin-*|practice) ;; *) continue ;; esac
        sf="$SRCSKILLS/$name/SKILL.md"
        if [ ! -f "$sf" ]; then TIERS="$TIERS ${name}:foreign"; continue; fi
        if [ "$(g_sha256_file "$f")" = "$(g_sha256_file "$sf")" ]; then
          TIERS="$TIERS ${name}:$scope"
          [ "$scope" = project ] && [ -n "$DET_HIT" ] && [ "$DET_HIT" = "$HOME" ] && TIERS="$TIERS (shadowing: the global tier also serves it)"
        else
          DIVERGED="$DIVERGED $name"
        fi
      done
    fi
    if [ -n "$TIERS" ] || [ -n "$DIVERGED" ]; then
      [ -n "$TIERS" ] && printf '  tier (%s)    %s\n' "$scope" "$TIERS"
      if [ -n "$DIVERGED" ]; then
        printf '  DIVERGED     (%s) project copy differs from the source payload:%s - legitimate, but it is the copy that wins\n' "$scope" "$DIVERGED"
      fi
    fi
  done

  # ---- the DRIFT oracle: what emit would write now vs what is on disk ----
  if [ -n "$DET_HIT" ] || [ -d "$TARGET/${A_PROJ%%<name>*}" ] || [ -f "$TARGET/$A_CTX" ]; then
    VERIFY="$ADAPTERS_DIR/$PLATFORM/verify.sh"
    if [ -x "$VERIFY" ] || [ -f "$VERIFY" ]; then
      if OUT=$(GOBLIN_DOCTOR_TARGET="$TARGET" GOBLIN_DOCTOR_HOME="$HOME" bash "$VERIFY" 2>&1); then
        printf '%s\n' "$OUT" | sed 's/^/  /'
      else
        DRIFT=1
        printf '  DRIFT        emitted bytes differ from what emit would write now:\n'
        printf '%s\n' "$OUT" | sed 's/^/    /'
      fi
    fi
  fi

  if [ "$DRIFT" -eq 1 ]; then
    VERDICT_MIN=1
  elif [ -z "$DET_HIT" ] && [ "$VERDICT_MIN" -ne 1 ]; then
    # a NOT-DETECTED platform is exit 2 only if nothing DRIFTed anywhere (§7)
    :
  fi
done

# ---- the exit driver (§7): 0 detected+clean · 1 any DRIFT · 2 nothing to probe ----
if [ "$VERDICT_MIN" -eq 1 ]; then
  exit 1
fi
# exit 2 iff NO probed platform was DETECTED (and none DRIFTed)
ANY_DETECTED=0
for PLATFORM in $PLATFORMS; do
  TSV="$ADAPTERS_DIR/$PLATFORM/adapter.tsv"
  [ -f "$TSV" ] || continue
  A_DETECT=$(awk -F'\t' '!/^#/ && NF>1 && $1 != "id" { print $3 }' "$TSV")
  IFS=':' read -ra ANCHORS <<< "$A_DETECT"
  for a in "${ANCHORS[@]}"; do
    case "$a" in
      "~"*) [ -d "${HOME}${a#\~}" ] && ANY_DETECTED=1 ;;
      /*)   [ -e "$a" ] && ANY_DETECTED=1 ;;
      *)    command -v "$a" >/dev/null 2>&1 && ANY_DETECTED=1 ;;
    esac
  done
done
[ "$ANY_DETECTED" -eq 1 ] && exit 0
exit 2
