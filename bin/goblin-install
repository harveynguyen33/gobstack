#!/usr/bin/env bash
# goblin-install — drop the harness into a target repo, idempotently.
#
# Usage: bash bin/goblin-install --target <dir> [options]   # checkout-only; `gob init --write` is the user surface
#   --target <dir>        required; the repo root to install into
#   --practice <path>     the referenced standard (default: $GOBLIN_PRACTICE; unset = empty
#                         practice: pin — a named path that is absent is reported, never
#                         silently dropped)
#   --parts <list>        comma list to install (default = the whole default part set)
#   --archive             mark the project archive: verify requires no HANDOFF and no gates
#   --skills <spec>       which skills to vendor into .gob/skills/ (default: the 7 core
#                         skills). <spec> is `no`/`yes` (the core tier), `all` (every skill
#                         in the repo's skills/), or a comma-separated list of skill names
#                         (`goblin-eval,goblin-tdd-repro`) — an unknown name is refused, never
#                         silently skipped. `yes` additionally installs the full set under
#                         .hermes/skills/ (the Hermes project tier).
#   --list-skills         print the skill library (name, tier, one-line purpose) and exit
#   --dry-run             print the plan; write nothing
#   --upgrade             re-install at the current version; report created/updated/unchanged/skipped
#   --opt-out <part>      record the part in disabled: so its required checks are skipped
#   --uninstall           remove exactly the files in installed.json
#   --re-pin              re-record practice_sha256: for an edited standard; nothing else changes
#   --force               allow overwriting a file goblin-stack did not create
#   --yes                 non-interactive; take the defaults above
#
# Exit codes: 0 success / no-op | 1 a refusal (with the path and the fix) | 2 bad input or a
# missing dependency.

set -uo pipefail

GOBLIN_INSTALL_VERSION="0.6.0-alpha.4"
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=$(cd "$SELF_DIR/.." && pwd)
# shellcheck source=goblin-lib.sh
. "$SELF_DIR/goblin-lib.sh"

# The skill LIBRARY: the repo's skills/ directory. The 7 CORE skills are the ones whose rows
# (SK-01/02/04) ride every install and are vendored by default; every other skill is available
# on request (`--skills all`, or a name list). This is the same shape the rule LIBRARY uses:
# a default set on, the rest held back and selectable, discoverable from the CLI (--list-skills).
CORE_SKILLS="goblin-mode goblin-investigation goblin-bugfix goblin-feature goblin-handoff goblin-verify-author practice"
# skill_list — name<TAB>one-line-purpose for every skill in $SRC/skills/, sorted. The purpose is
# the first line of the SKILL.md frontmatter `description:` (the same field SK-01 requires).
skill_list() {
  local d name desc
  for d in "$SRC"/skills/*/; do
    [ -f "$d/SKILL.md" ] || continue
    name=$(basename "$d")
    desc=$(awk 'NR==1{f=1;next} /^---/{f=0} f&&/^description:/{sub(/^description:[[:space:]]*/,"");print;exit}' "$d/SKILL.md")
    printf '%s\t%s\n' "$name" "$desc"
  done | sort
}
skill_names() { skill_list | cut -f1; }
# skill_tier <name> — core | optional
skill_tier() { case " $CORE_SKILLS " in *" $1 "*) printf 'core' ;; *) printf 'optional' ;; esac; }

TARGET=""
# QA fix (v2-qa issue 4): the old default was $HOME/projects/PROJECT-PRACTICE.md - the
# MAINTAINER's home layout baked into every rendered config on every machine, including a
# fresh contributor's (their rendered AGENTS.md pointed at a file that does not exist on
# their machine). The neutral default is EMPTY: the practice pin stays empty (verify
# treats that as the legitimate no-standard state). A machine that HAS a standard exports
# GOBLIN_PRACTICE (or passes --practice) and gets the same rendering as before.
PRACTICE="${GOBLIN_PRACTICE:-}"
# W5-3: `--practice <path>` naming a file that is not there used to be IGNORED IN SILENCE -
# exit 0, `practice: ~`, `practice_sha256: ~`, and not one line about it in the install log.
# The empty pin is a legitimate state (a repo may reference no standard, and the default path is
# allowed to be absent), so this is a refusal to be silent, not a refusal to install: the value
# stays empty and the log names the path that was not found.
PRACTICE_ARG=""
PARTS=""
ARCHIVE="false"
# W6 neutral-first: a default install is a NEUTRAL harness (manifest + verify + HANDOFF +
# .goblin) with NO agent skills. Agent skills are an explicit opt-in (--skills yes, or the
# per-platform gob emit path the wizard's emit screen drives). The old default (yes) was the
# house's own setup, not a product default: a non-agent user got a dead .hermes/ tree, and a
# user of another agent harness got nothing at all.
SKILLS="no"
# Whether --skills was named on the command line: an OMITTED flag on a re-install means
# "whatever the record says" (the migration contract below); a NAMED --skills no is an
# explicit opt-out and is honoured verbatim.
SKILLS_NAMED=0
LIST_SKILLS=0
DRY_RUN=0
UPGRADE=0
UNINSTALL=0
RE_PIN=0
FORCE=0
OPT_OUT=""
GATE_NAME_ARG=""   # parsed by --gate <cmd> [name] below; reset before the loop
# CI_GATE_OPT is gone with the CI lane (v2): no flag, no workflow file, no ci_gate field.

usage() {
  # The header comment runs from line 2 to the first blank line, so adding an option cannot
  # truncate the help or leak code into it. The old fixed range ('2,22p') ended on the
  # `set -uo pipefail` line and printed it as if it were an option.
  sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    --target)    TARGET="${2:-}"; shift 2 ;;
    --practice)  PRACTICE="${2:-}"; PRACTICE_ARG="$PRACTICE"; shift 2 ;;
    --parts)     PARTS="${2:-}"; shift 2 ;;
    --archive)   ARCHIVE="true"; shift ;;
    --skills)    SKILLS="${2:-}"; SKILLS_NAMED=1; shift 2 ;;
    --list-skills) LIST_SKILLS=1; shift ;;
    --dry-run)   DRY_RUN=1; shift ;;
    --upgrade)   UPGRADE=1; shift ;;
    --uninstall) UNINSTALL=1; shift ;;
    --re-pin)    RE_PIN=1; shift ;;
    --opt-out)   OPT_OUT="${2:-}"; shift 2 ;;
    --gate)      GOB_GATE="${2:-}"; GATE_NAME_ARG="${3:-}"; shift 2; [ -n "${GATE_NAME_ARG:-}" ] && shift; shift ;;
    --force)     FORCE=1; shift ;;
    --yes)       shift ;;
    -h|--help)   usage; exit 0 ;;
    *) g_err "unknown option: $1"; usage >&2; exit 2 ;;
  esac
done

for dep in git awk sed grep; do
  command -v "$dep" >/dev/null 2>&1 || { g_err "missing dependency: $dep"; exit 2; }
done

# --list-skills: print the library and exit. This is the discovery surface BEFORE choosing — the
# same role `gob verify --library` plays for the rule rows. It needs no --target and writes nothing.
if [ "$LIST_SKILLS" -eq 1 ]; then
  printf 'the skill library (%s/skills/):\n' "$SRC"
  printf '  %-22s %-9s %s\n' NAME TIER PURPOSE
  while IFS=$'\t' read -r n p; do
    printf '  %-22s %-9s %s\n' "$n" "$(skill_tier "$n")" "$p"
  done < <(skill_list)
  printf '\ndefault install: the 7 core skills. choose with --skills all | <name>[,<name>...]\n'
  exit 0
fi

[ -n "$TARGET" ] || { g_err "--target is required"; exit 2; }
TARGET=$(g_expand_tilde "$TARGET")
[ -d "$TARGET" ] || { g_err "--target is not a directory: $TARGET"; exit 2; }
TARGET=$(cd "$TARGET" && pwd)
[ -f "$SRC/VERSION" ] || { g_err "no VERSION at $SRC — is this a goblin-stack checkout?"; exit 2; }

VERSION=$(head -n 1 "$SRC/VERSION")
INSTALLED="$TARGET/.gob/installed.json"
CONFIG="$TARGET/AGENTS.md"
STAMP=$(date +%F)

# --uninstall and --re-pin are different jobs, and this guard has to sit ABOVE the uninstall
# branch: that branch ends `exit 0`, so the same check placed below it was unreachable and
# `--uninstall --re-pin` ran the uninstall without ever seeing the refusal (measured at bf7e9c9:
# exit 0, target uninstalled, "different jobs" never printed).
if [ "$UNINSTALL" -eq 1 ] && [ "$RE_PIN" -eq 1 ]; then
  g_err "--uninstall and --re-pin are different jobs; run them one at a time"
  exit 2
fi

# ------------------------------------------------------------- uninstall ------
if [ "$UNINSTALL" -eq 1 ]; then
  [ -f "$INSTALLED" ] || { g_err "nothing to uninstall: $INSTALLED is absent"; exit 2; }
  n=0
  PARENTS=""
  while IFS=$'\t' read -r p h; do
    [ -n "$p" ] || continue
    [ -e "$TARGET/$p" ] || continue
    if [ "$DRY_RUN" -eq 1 ]; then g_info "would remove $p"; else rm -f "$TARGET/$p"; fi
    n=$((n + 1))
    # EVERY ancestor directory, not just the immediate parent: a file at
    # .github/workflows/goblin-gate.yml empties two levels, and collecting only `${p%/*}` left
    # .github/ behind with nothing named (the shape t-uninstall.sh asserts against).
    d="$p"; while [ "${d%/*}" != "$d" ]; do d="${d%/*}"; PARENTS="$PARENTS$d"$'\n'; done
  done < <(g_installed_files "$INSTALLED")
  # The config lives in the AGENTS.md gob block: uninstall strips ONLY the marker block and
  # keeps the file (the body prose is the project's). A file with no gob block is untouched.
  if [ -f "$CONFIG" ] && grep -q "^$GOB_AGENTS_BEGIN" "$CONFIG" 2>/dev/null; then
    if [ "$DRY_RUN" -eq 1 ]; then
      g_info "would remove the gob block from $CONFIG (the body prose stays)"
    else
      awk -v begin="^$GOB_AGENTS_BEGIN" -v end="^$GOB_AGENTS_END" '
        $0 ~ begin { inb = 1; next } $0 ~ end { inb = 0; next } !inb { print }
      ' "$CONFIG" > "$CONFIG.nogob" && mv "$CONFIG.nogob" "$CONFIG"
      g_info "removed the gob block from AGENTS.md (the body prose stays)"
    fi
  fi
  # Runtime state goblin-stack's own checks wrote.
  for f in .gob/last-gate-line .gob/ratchet-last .gob/.ds-report; do
    [ -f "$TARGET/$f" ] || continue
    [ "$DRY_RUN" -eq 1 ] || rm -f "$TARGET/$f"
    g_info "removed $f (runtime state)"
  done
  # The repo-distributed MCP registration (init --write): removed ONLY when it
  # still carries the generated bytes — the preimage pattern, the same clause the decision
  # records below get. A hand-tuned or team-customized .mcp.json is the project's and stays.
  if [ -f "$TARGET/.mcp.json" ]; then
    if [ "$(cat "$TARGET/.mcp.json" 2>/dev/null)" = '{"mcpServers":{"gob":{"command":"npx","args":["-y","@techgoblin/gobstack","mcp"]}}}' ]; then
      [ "$DRY_RUN" -eq 1 ] || rm -f "$TARGET/.mcp.json"
      g_info "removed .mcp.json (the generated registration)"
    else
      g_info "kept .mcp.json (not the generated bytes: a registration you customized stays)"
    fi
  fi
  # The three decision records (audit waivers, boundary waivers, the install-hook allowlist) are
  # put_once files. An UNEDITED one is still goblin-stack's template and goes; an EDITED one is
  # the project's decision and stays, named in the summary. Deleting a decision silently would be
  # data loss; leaving an untouched template behind would be residue (both were measured).
  KEPT=""
  while IFS=$'\t' read -r p h; do
    [ -n "$p" ] || continue
    case "$p" in
      .gob/boundary-waivers) ;;
      *) continue ;;
    esac
    [ -e "$TARGET/$p" ] || continue
    if [ "$(g_sha256_file "$TARGET/$p")" = "$h" ]; then
      [ "$DRY_RUN" -eq 1 ] || rm -f "$TARGET/$p"
      g_info "removed $p (unedited template)"
      n=$((n + 1))
      case "$p" in */*) PARENTS="$PARENTS${p%/*}"$'\n' ;; esac
    else
      KEPT="$KEPT $p"
      g_info "kept $p (you edited it: a decision record is the project's, not the harness's)"
    fi
  done < <(g_json_object "$INSTALLED" owned)
  # installed.json goes BEFORE the directory pass. While it was still on disk, .gob/ was
  # never empty when it was tested, so the directory survived unnamed (D17 / F2-7).
  if [ "$DRY_RUN" -eq 0 ]; then
    rm -f "$INSTALLED"
    if [ -f "$TARGET/.gitignore" ]; then
      printf '# goblin-stack uninstalled %s\n' "$STAMP" >> "$TARGET/.gitignore"
    fi
  fi
  # Empty directories goblin-stack created: the parents of the files just removed, plus the
  # harness roots. Deepest first, so a parent is only tested once its child has gone. The
  # old fixed list never tried .hermes/skills/goblin-* and tested .gob/ too early.
  nd=0
  while read -r d; do
    [ -n "$d" ] || continue
    [ -d "$TARGET/$d" ] || continue
    if [ "$DRY_RUN" -eq 1 ]; then
      g_info "would remove $d/ (if the files above leave it empty)"
      nd=$((nd + 1))
      continue
    fi
    if [ -z "$(ls -A "$TARGET/$d" 2>/dev/null)" ]; then
      rmdir "$TARGET/$d" 2>/dev/null && { g_info "removed $d/ (empty)"; nd=$((nd + 1)); }
    fi
  done < <({
      printf '%s' "$PARENTS"
      printf '.goblin\n.gob/bin\n.gob/manifest\n.gob/bans\n.hermes\n.hermes/skills\n'
    } | awk 'NF' | awk -F/ '{print NF " " $0}' | sort -rn | cut -d' ' -f2- | awk '!seen[$0]++')
  g_info "removed $n file(s) and $nd empty director(y|ies). Left in place: HANDOFF.md, AGENTS.md, the .gitignore block${KEPT:+, and the decision record(s) you edited:$KEPT}."
  # QA fix (v2-qa issue 10): honesty about what the uninstall leaves UNTOUCHED. Two
  # by-design residues a reader could otherwise read as a clean sweep:
  #   - the .gitignore block the install appended stays (removing it could eat a
  #     line the project added inside the block; the preimage is untracked text),
  #   - prose in kept files (HANDOFF.md, AGENTS.md body) may still name
  #     now-deleted paths (.gob/bin/goblin-verify, checks/) — those references are
  #     dead after this command.
  g_info "  note: the .gitignore ignore-rules block stays (by design: it may carry lines the project added; remove it by hand if you want it gone)"
  g_info "  note: prose that names .gob/ paths (HANDOFF.md, AGENTS.md body) now points at removed files — those references are dead"
  exit 0
fi

# ---------------------------------------------------------------- re-pin ------
# The practice pin (practice_sha256: in the AGENTS.md gob block, re-checked by IN-02) exists to
# catch a SILENTLY edited standard. The standard itself is a living document edited in place, and
# the block is `owned` content the installer never rewrites - so the remedy for an edit that IS
# intended has to be explicit, printed and deliberate. This mode rewrites exactly one line and
# reports the old and new hash. It is unreachable from --upgrade and from goblin-verify, by
# design: an automatic re-pin would be the silent edit the pin exists to catch.
# See docs/GUIDE.md, "An edited standard is not a dead end".
# The write's own failure output is captured (not discarded) so the fail-closed branch below can
# name it: a g_agents_write that could not land used to vanish into >/dev/null and the pipe still
# exited 0 (the sed inside writes via mktemp+mv, and only the mv reports).
RE_PIN_WRITE_LOG=""
if [ "$RE_PIN" -eq 1 ]; then
  [ -f "$CONFIG" ] || { g_err "nothing to re-pin: $CONFIG is absent (install first)"; exit 2; }
  PIN_PATH=$(g_expand_tilde "$(g_agents_read "$CONFIG" practice)")
  [ -n "$PIN_PATH" ] || { g_err "no practice: recorded in $CONFIG — nothing to re-pin"; exit 2; }
  [ -f "$PIN_PATH" ] || { g_err "the recorded standard is absent: $PIN_PATH"; exit 2; }
  # g_unquote, exactly as goblin-verify reads it: a hand-quoted value is accepted by the verifier,
  # so it must not read as "different" here and trigger a rewrite of a line that already matches.
  OLD_SHA=$(g_unquote "$(g_agents_read "$CONFIG" practice_sha256)")
  NEW_SHA=$(g_sha256_file "$PIN_PATH")
  if [ "$OLD_SHA" = "$NEW_SHA" ]; then
    g_info "practice pin already current: $PIN_PATH"
    g_info "  recorded $OLD_SHA"
    exit 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    g_info "would re-pin $PIN_PATH"
    g_info "  recorded $OLD_SHA"
    g_info "  now      $NEW_SHA"
    exit 0
  fi
  # One key, in place: g_agents_write rewrites only the marker block, and the rewrite keeps
  # every OTHER key by reading the current block first (the `owned` contract holds for
  # everything except the single value just asked for). The write's failure output is captured,
  # not discarded: a g_agents_write that could not land used to vanish into >/dev/null and only
  # the generic fail-closed message remained.
  RE_PIN_WRITE_LOG=$(mktemp "${TMPDIR:-/tmp}/gob-repin.XXXXXX")
  {
    while IFS=$'\t' read -r k v; do
      [ "$k" = "practice_sha256" ] && continue
      printf '%s\t%s\n' "$k" "$v"
    done < <(g_agents_pairs "$CONFIG")
    printf 'practice_sha256\t%s\n' "$NEW_SHA"
  } | g_agents_write "$CONFIG" > "$RE_PIN_WRITE_LOG" 2>&1 \
    || { g_err "could not rewrite the pin in $CONFIG"; sed -n '1,3p' "$RE_PIN_WRITE_LOG" >&2 2>/dev/null; rm -f "$RE_PIN_WRITE_LOG"; exit 1; }
  rm -f "$RE_PIN_WRITE_LOG"
  # Fail closed: never report a re-pin that did not land.
  [ "$(g_agents_read "$CONFIG" practice_sha256)" = "$NEW_SHA" ] \
    || { g_err "the new pin did not land in $CONFIG"; exit 1; }
  g_info "practice re-pinned: $PIN_PATH"
  g_info "  recorded $OLD_SHA"
  g_info "  now      $NEW_SHA"
  g_info ""
  g_info "next:"
  g_info "  1. cd $TARGET && git add AGENTS.md && git commit   # the re-pin is a change like any other"
  g_info "  2. .gob/bin/goblin-verify --only IN-02   # practice pin ok"
  exit 0
fi

# W6 migration safety: on a --upgrade (or any re-install) of a repo whose record shows skills
# were installed, an OMITTED --skills flag must READ that state, not silently strip it. The
# idempotence contract (created/updated/unchanged) holds only if the effective skills choice
# for a flag-less re-install is `the record's choice`, so previously-installed skills survive
# every upgrade unchanged. An EXPLICIT --skills no is honoured verbatim (the switch stays
# real), and --uninstall still removes exactly what the record lists. The record's value may be
# yes, no, all, or a name list — a flag-less re-install reads whichever it was, so a chosen set
# is stable through every re-install.
if [ -f "$INSTALLED" ] && [ "$SKILLS_NAMED" -eq 0 ]; then
  PREV_SKILLS=$(g_installed_scalar_options "$INSTALLED" skills)
  case "$PREV_SKILLS" in
    ""|no) ;;
    *) SKILLS="$PREV_SKILLS"
       g_info "skills: this repo's install record has agent skills installed - they are kept (remove them with an explicit --skills no, or --uninstall)" ;;
  esac
fi

# --skills spec, validated AFTER the migration read so a recorded choice is accepted too:
#   yes|no  the 7-skill core tier (yes also installs the full set under .hermes/skills/)
#   all     every skill in the repo's skills/
#   a,b,c   exactly those names
# A name that does not exist is REFUSED — with the available set named — never silently skipped.
# The check runs before anything is planned or written, so a refused selection leaves no partial
# install (the fail-closed shape the honesty gate uses for rows).
case "$SKILLS" in
  yes|no|all) ;;
  "")
    g_err "--skills needs a value: yes, no, all, or a comma-separated skill name list (run --list-skills)"; exit 2 ;;
  *)
    BAD_NAMES=""
    for _n in $(printf '%s' "$SKILLS" | tr ',' ' '); do
      [ -n "$_n" ] || continue
      [ -d "$SRC/skills/$_n" ] || BAD_NAMES="$BAD_NAMES $_n"
    done
    if [ -n "$BAD_NAMES" ]; then
      g_err "unknown --skills name(s):$BAD_NAMES"
      g_err "  available: $(skill_names | paste -sd, -)"
      g_err "  or use --skills all (every skill) / --skills no (the 7 core skills)"
      exit 2
    fi ;;
esac

# The default config block: ONE built-in set of values (the old software preset). There is no
# class and no preset file: a class only ever selected which bans ran, and the ban table now
# self-selects per row via applies_when, so the installer needs no taxonomy to render a block.
# --- default key/values (key<TAB>value) ---
default_tsv() {
cat <<'XEOF'
harness_dir	checks
scaffold_checks	yes
gate_name	commit
gate_cmd	git rev-parse --verify --quiet HEAD
gate2_name	todo_ceiling
gate2_cmd	test "$(grep -rniE '\b(TODO|FIXME)\b' --include='*.ts' --include='*.tsx' --include='*.js' --include='*.jsx' --include='*.mjs' . 2>/dev/null | wc -l)" -le 160
ratchet_name	client_js_bytes
ratchet_cmd	find .next/static dist/assets dist -type f -name '*.js' -exec cat {} + 2>/dev/null | wc -c
ratchet_ceiling	measure
replay_env	GOBLIN_PRE_COMMIT
replay_cmd	node checks/{name}.mjs
runtime_data	.gob/state.json
advisory_ceiling	10
sec_gitignore_family	yes
sec_build_output	.next/static dist/assets dist
sec_write_routes	app src/app
perf_metric	client_js_bytes
perf_cmd	find .next/static dist/assets dist -type f -name '*.js' -exec cat {} + 2>/dev/null | wc -c
perf_baseline_commit	
perf_baseline_value	0
perf_measured	
perf_host_gate	
bans_disabled	
XEOF
}
default_() { default_tsv | awk -F'\t' -v OFS='\t' -v k="$1" '$1==k { $1=""; sub(/^\t/,""); print; exit }'; }

HARNESS_DIR=$(default_ harness_dir); [ -n "$HARNESS_DIR" ] || HARNESS_DIR=checks
SCAFFOLD=$(default_ scaffold_checks); [ -n "$SCAFFOLD" ] || SCAFFOLD=no
GATE_NAME=$(default_ gate_name)
# (GATE1/GATE2 render names are set in render_config; the default keys are unchanged.)
GATE_CMD=$(default_ gate_cmd)
# `--gate <cmd>` (gob init --write): the proposal's first gate REPLACES the default.
# `--gate <cmd> <name>` (optional 2nd word): the proposal may also name the gate — the
# HANDOFF template renders THAT name, so HP-03 (anchored on the DECLARED names) sees the
# gate line a fresh HANDOFF carries even when the name is not the default.
case "${GATE_NAME_ARG:-}" in "") ;; *) GATE_NAME="$GATE_NAME_ARG" ;; esac
[ -n "${GOB_GATE:-}" ] && GATE_CMD="$GOB_GATE"
# Whether the gate was DECLARED by the caller (gob init --write passes --gate, having MEASURED
# it) or is the installer's generic default. The next-steps advice depends on it: a declared gate
# is already real and owes no edit, while the default gate does. GATE_LABEL is non-empty only for
# a declared gate and rides into g_next_block.
GATE_LABEL=""
[ -n "${GOB_GATE:-}" ] && GATE_LABEL="$GATE_NAME: $GATE_CMD"
RAT_NAME=$(default_ ratchet_name)
RAT_CMD=$(default_ ratchet_cmd)
RAT_CEIL=$(default_ ratchet_ceiling)
REPLAY_ENV=$(default_ replay_env)
REPLAY_CMD=$(default_ replay_cmd)
RUNTIME_DATA=$(default_ runtime_data)
ADV_CEILING=$(default_ advisory_ceiling); [ -n "$ADV_CEILING" ] || ADV_CEILING=10
# The optional second gate (the TODO ceiling); blank it to render one gate only.
GATE2_NAME=$(default_ gate2_name)
GATE2_CMD=$(default_ gate2_cmd)
# The security surface (SC-01..SC-09) and the perf baseline (PF-01).
SEC_GITIGNORE_FAMILY=$(default_ sec_gitignore_family); [ -n "$SEC_GITIGNORE_FAMILY" ] || SEC_GITIGNORE_FAMILY=no
SEC_BUILD_OUTPUT=$(default_ sec_build_output)
SEC_WRITE_ROUTES=$(default_ sec_write_routes)
PERF_METRIC=$(default_ perf_metric)
PERF_CMD=$(default_ perf_cmd)
PERF_BASELINE_COMMIT=$(default_ perf_baseline_commit)
PERF_BASELINE_VALUE=$(default_ perf_baseline_value); [ -n "$PERF_BASELINE_VALUE" ] || PERF_BASELINE_VALUE=0
PERF_MEASURED=$(default_ perf_measured)
PERF_HOST_GATE=$(default_ perf_host_gate)
# The ban selection is the GLOB (a ban runs when a real file matches its applies_when cell);
# the only config knob is an explicit DISABLE list, rendered empty by default. A ban outside
# any of this is on automatically.
BANS_DISABLED=$(default_ bans_disabled)
# `layers:` is a block list the project declares; the default ships none, so it renders empty
# and BN-05 SKIPs with that reason until the project declares a from/to pair.
LAYERS_BLOCK=""

# Every part is on by default (there is no class turning parts off). The CORE procedure
# tier is vendored on EVERY install (.gob/skills/), so the product never disables its own
# skill rows (SK-01/02/04) — a fresh repo's harness runs them instead of skipping. An
# explicit --opt-out is the only thing that records a part in disabled:.
DISABLED=""
if [ -n "$OPT_OUT" ]; then DISABLED="$DISABLED$OPT_OUT,"; fi
DISABLED=$(printf '%s' "$DISABLED" | tr ',' '\n' | grep -v '^$' | sort -u | paste -sd, -)

# FIX 3: a *-SPEC.md and reviews/ are policed by LIBRARY rows (SP-01..03, PG-01..03, off by
# default), so a default install ships NEITHER: an artefact nothing checks on this repo is a false
# promise ("the installer scaffolds rows that are off by default"). They come back only on an
# explicit opt-in, `--parts spec` / `--parts reviews` — the same surface a repo turns the library
# rows on through — because "create them when the row is enabled" is not knowable at install time
# (enablement is a POST-install edit of .gob/manifest/enforcement.local.tsv). The installed file
# set therefore matches what the ENABLED (default) rows actually need.
WANT_SPEC=0
WANT_REVIEWS=0
case ",${PARTS}," in *,spec,*)    WANT_SPEC=1 ;; esac
case ",${PARTS}," in *,reviews,*) WANT_REVIEWS=1 ;; esac
WANT_RATCHET=1
# The CI lane is GONE (v2 product decision): no .github/workflows file is written and no flag
# configures it.
WANT_CI_GATE=0
[ "$ARCHIVE" = "true" ] && { WANT_SPEC=0; WANT_REVIEWS=0; SCAFFOLD=no; }

HEAD_SHORT=$( cd "$TARGET" && git rev-parse --short HEAD 2>/dev/null )
[ -n "$HEAD_SHORT" ] || HEAD_SHORT="0000000"

# practice pin
if [ -f "$(g_expand_tilde "$PRACTICE")" ]; then
  PRACTICE_SHA=$(g_sha256_file "$(g_expand_tilde "$PRACTICE")")
else
  # W5-3: an explicitly named --practice that does not resolve is REPORTED, not swallowed. The
  # pin stays empty (a repo with no referenced standard is legitimate), but a flag nobody honours
  # has to say so - `practice: ~` with no line in the log is the "silent no-op" species.
  if [ -n "$PRACTICE_ARG" ]; then
    g_info "warning: --practice $PRACTICE_ARG does not exist - no standard is referenced"
    g_info "         (practice: and practice_sha256: stay empty in the AGENTS.md gob block)"
  fi
  PRACTICE=""
  PRACTICE_SHA=""
fi

# ratchet ceiling: measured at install time, so the ratchet starts anchored to reality
if [ "$RAT_CEIL" = "measure" ]; then
  RAT_CEIL=$( cd "$TARGET" && bash -c "$RAT_CMD" 2>/dev/null | tr -d '[:space:]' )
  case "$RAT_CEIL" in ''|*[!0-9]*) RAT_CEIL=0 ;; esac
fi
[ "$WANT_RATCHET" -eq 0 ] && { RAT_NAME=""; RAT_CMD=""; RAT_CEIL=0; }

# parts selected with --parts
part_wanted() {
  [ -z "$PARTS" ] && return 0
  case ",$PARTS," in *",$1,"*) return 0 ;; esac
  return 1
}

# ------------------------------------------------------------------ plan -----
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
: > "$TMP/files.tsv"
: > "$TMP/owned.tsv"
: > "$TMP/refused.tsv"
CREATED=0; UPDATED=0; UNCHANGED=0; SKIPPED=0
REFUSED_PATHS=""
# Files a PREVIOUS run created and left to the user (never overwritten, never hash-checked).
PREV_OWNED=""
# Files a PREVIOUS run installed (the hash-checked 'files' map). A path that exists on disk
# but is NOT in this map was not created by goblin-stack, so it is refused rather than
# clobbered - the contract in docs/GUIDE.md. --force is the only way past it.
PREV_FILES=""
if [ -f "$INSTALLED" ]; then
  PREV_OWNED=$(g_json_object "$INSTALLED" owned | cut -f1)
  PREV_FILES=$(g_installed_files "$INSTALLED" | cut -f1)
fi

# prev_installed <relpath> - did a previous run install this exact path?
prev_installed() {
  [ -n "$PREV_FILES" ] || return 1
  printf '%s\n' "$PREV_FILES" | grep -qxF "$1"
}

render() { # render <template> key value [key value ...]
  local tpl="$1"; shift
  local out; out=$(cat "$tpl")
  while [ $# -ge 2 ]; do out=${out//"{{$1}}"/$2}; shift 2; done
  printf '%s\n' "$out"
}

# put <relpath> <source-file> [refuse-overwrite]
# Refuses when the destination exists with different content and goblin-stack did not install
# it: either the caller asked for it explicitly ('refuse') or the path is not in the previous
# run's 'files' map. --force is the documented override.
put() {
  local rel="$1" srcf="$2" refuse="${3:-}"
  local dst="$TARGET/$rel" srch cur
  srch=$(g_sha256_file "$srcf")
  if [ -f "$dst" ]; then
    cur=$(g_sha256_file "$dst")
    if [ "$cur" = "$srch" ]; then
      UNCHANGED=$((UNCHANGED + 1))
      printf '%s\t%s\n' "$rel" "$srch" >> "$TMP/files.tsv"
      return 0
    fi
    if [ "$FORCE" -eq 0 ] && { [ "$refuse" = "refuse" ] || ! prev_installed "$rel"; }; then
      SKIPPED=$((SKIPPED + 1))
      printf '%s\t%s\n' "$rel" "$cur" >> "$TMP/refused.tsv"
      REFUSED_PATHS="$REFUSED_PATHS $rel"
      g_info "kept (exists, not installed by goblin-stack): $rel"
      return 0
    fi
    UPDATED=$((UPDATED + 1))
  else
    CREATED=$((CREATED + 1))
  fi
  if [ "$DRY_RUN" -eq 1 ]; then g_info "plan: $rel"; else
    mkdir -p "$(dirname "$dst")"
    cp "$srcf" "$dst"
    [ -x "$srcf" ] && chmod +x "$dst"
  fi
  printf '%s\t%s\n' "$rel" "$srch" >> "$TMP/files.tsv"
}

# put_once <relpath> <source-file> — created once, then YOURS. Never overwritten, never
# hash-checked (you are meant to edit it), and left in place by --uninstall.
put_once() {
  local rel="$1" srcf="$2"
  local dst="$TARGET/$rel" srch cur
  srch=$(g_sha256_file "$srcf")
  if [ -f "$dst" ] && [ "$FORCE" -eq 1 ] && ! printf '%s\n' "$PREV_OWNED" | grep -qxF "$rel"; then
    # --force is the documented override for "a file goblin-stack did not create" (D11). A file
    # a previous install created is 'yours' by contract, and --force does not take it back.
    UPDATED=$((UPDATED + 1))
    g_info "taken over (--force): $rel"
    if [ "$DRY_RUN" -eq 0 ]; then cp "$srcf" "$dst"; fi
    printf '%s\t%s\n' "$rel" "$srch" >> "$TMP/owned.tsv"
    return 0
  fi
  if [ -f "$dst" ]; then
    SKIPPED=$((SKIPPED + 1))
    if printf '%s\n' "$PREV_OWNED" | grep -qxF "$rel"; then
      g_info "kept (yours, never overwritten): $rel"
      # Still recorded as yours, so the next install keeps treating it that way.
      printf '%s\t%s\n' "$rel" "$srch" >> "$TMP/owned.tsv"
    else
      cur=$(g_sha256_file "$dst")
      printf '%s\t%s\n' "$rel" "$cur" >> "$TMP/refused.tsv"
      REFUSED_PATHS="$REFUSED_PATHS $rel"
      g_info "kept (existed before the install, never overwritten): $rel"
    fi
    # A refused file is NOT recorded as owned: it was never goblin-stack's, so a later run
    # must refuse it again rather than inherit ownership of it (D11).
    return 0
  fi
  CREATED=$((CREATED + 1))
  if [ "$DRY_RUN" -eq 1 ]; then
    g_info "plan: $rel"
  else
    mkdir -p "$(dirname "$dst")"
    cp "$srcf" "$dst"
  fi
  printf '%s\t%s\n' "$rel" "$srch" >> "$TMP/owned.tsv"
}

# ------------------------------------------------------- generated content ---
render_config() {
  local gates runtime
  # v2 gate shape: one flat key per gate (gate_<name>_cmd:). The default declares a second
  # gate (the TODO ceiling, G4 D2); with none, the gate name renders empty and the key line
  # is dropped below.
  GATE1_NAME="$GATE_NAME"; GATE1_CMD="$GATE_CMD"
  GATE2_RENDER_NAME="$GATE2_NAME"; GATE2_RENDER_CMD="$GATE2_CMD"
  runtime="$RUNTIME_DATA"
  render "$SRC/templates/agents-block.tmpl" \
    PRACTICE "$PRACTICE" \
    PRACTICE_SHA "$PRACTICE_SHA" \
    ARCHIVE "$ARCHIVE" \
    MAX_DIRTY "0" \
    ADVISORY_CEILING "$ADV_CEILING" \
    SEC_GITIGNORE_FAMILY "$SEC_GITIGNORE_FAMILY" \
    SEC_BUILD_OUTPUT "$SEC_BUILD_OUTPUT" \
    SEC_WRITE_ROUTES "$SEC_WRITE_ROUTES" \
    PERF_METRIC "$PERF_METRIC" \
    PERF_CMD "$PERF_CMD" \
    PERF_BASELINE_COMMIT "$PERF_BASELINE_COMMIT" \
    PERF_BASELINE_VALUE "$PERF_BASELINE_VALUE" \
    PERF_MEASURED "$PERF_MEASURED" \
    PERF_HOST_GATE "$PERF_HOST_GATE" \
    HARNESS_DIR "$HARNESS_DIR" \
    SCAFFOLD_CHECKS "$SCAFFOLD" \
    FEATURE_MAP "" \
    SOURCE_ROOT "." \
    VERIFY_DOCTOR "" \
    REFERENCE_MANIFEST "" \
    QUARANTINE_ROOT "" \
    GATE1_NAME "$GATE1_NAME" \
    GATE1_CMD "$GATE1_CMD" \
    GATE2_NAME "$GATE2_RENDER_NAME" \
    GATE2_CMD "$GATE2_RENDER_CMD" \
    RATCHET_NAME "$RAT_NAME" \
    RATCHET_CMD "$RAT_CMD" \
    RATCHET_CEILING "$RAT_CEIL" \
    RUNTIME_DATA "$runtime" \
    BANS_DISABLED "$BANS_DISABLED" \
    BANS_EXEMPT "" \
    LAYERS "$LAYERS_BLOCK" \
    REPLAY_ENV "$REPLAY_ENV" \
    REPLAY_CMD "$REPLAY_CMD" \
    DISABLED "$DISABLED" > "$TMP/agents-block.raw"
  # A gate with no name renders a `gate__cmd:` line - dropped, not shipped.
  grep -v '^gate__cmd: $' "$TMP/agents-block.raw" > "$TMP/agents-block"
}

render_config
# The re-shadow refusal (W3 §5.3): a record with engine.mode=global is a MIGRATED repo.
# Re-installing would recreate the 18-file payload (the vendored step of the resolution
# chain then beats the declared engine_dir — the shadowing hazard, W3-SPEC §3.1) AND
# rewrite the record from scratch, silently de-migrating it. The writer below has no
# engine:-block support, so the rewrite is not a migration-aware update — it is a
# regression. The exits out of a migrated repo are `git revert` of the migration's two
# commits, or a hand edit of the engine_dir line (docs/GUIDE.md "Rolling back a
# migration"). DRY_RUN reports the refusal too: the plan it prints is not shippable.
# The guard sits BEFORE the put-loop: a refusal that fires after the payload phase has
# already re-created the 18 files is a refusal that itself shadows (measured: U11's
# 'the refused install wrote nothing' failed on exactly that).
g_install_engine_mode() {
  awk -v q='"' -v k="mode" '
    index($0, q "engine" q) && /:[[:space:]]*\{/ { inf = 1; next }
    inf && /^[[:space:]]*\}/ { inf = 0 }
    inf && index($0, q k q) {
      v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/,?[[:space:]]*$/, "", v)
      gsub(q, "", v); print v; exit
    }
  ' "$1" 2>/dev/null
}
if [ -f "$INSTALLED" ] && [ "$(g_install_engine_mode "$INSTALLED")" = "global" ]; then
  g_rec_engine_dir=$(awk -v q='"' '
    index($0, q "engine" q) && /:[[:space:]]*\{/ { inf = 1; next }
    inf && /^[[:space:]]*\}/ { inf = 0 }
    inf && index($0, q "engine_dir" q) {
      v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/,?[[:space:]]*$/, "", v)
      gsub(q, "", v); print v; exit
    }
  ' "$INSTALLED")
  g_err "goblin-install: $TARGET is migrated to the global engine at ${g_rec_engine_dir:-<unknown>}. Re-installing would re-shadow it and rewrite its migration record. To return to a vendored engine: git revert the two W3 commits (see docs/GUIDE.md \"Rolling back a migration\"). To re-point at a different engine: edit AGENTS.md's engine_dir line."
  exit 1
fi

put ".gob/bin/goblin-verify" "$SRC/bin/goblin-verify"
put ".gob/bin/goblin-lib.sh" "$SRC/bin/goblin-lib.sh"
put ".gob/manifest/enforcement.tsv" "$SRC/manifest/enforcement.tsv"
# The library (batch 2b-ii): the off-by-default rows, held next to the matrix so `gob verify
# --library` can list them and the summary can count them. Data, not a check: it ships whole
# or not at all with the manifest it is the complement of.
put ".gob/manifest/library.tsv" "$SRC/manifest/library.tsv"
put ".gob/manifest/playbooks.tsv" "$SRC/manifest/playbooks.tsv"
put ".gob/manifest/glossary.tsv" "$SRC/manifest/glossary.tsv"
# The ban list (G5): the table, the engine, and the two probes. A ban with no mechanism is a
# wish, so the table and the engine install together or not at all.
put ".gob/manifest/bans.tsv" "$SRC/manifest/bans.tsv"
put ".gob/bin/goblin-bans" "$SRC/bin/goblin-bans"
put ".gob/bans/README.md" "$SRC/bans/README.md"
put ".gob/bans/grep-ban.sh" "$SRC/bans/grep-ban.sh"
put ".gob/bans/layer-check.sh" "$SRC/bans/layer-check.sh"
# The AGENTS.md frontmatter: the body prose is rendered once (put_once), then the marker
# block is written into it through g_agents_write — the same path every later rewrite takes,
# so the block is never a second copy of the file and the body is never machine-owned.
render "$SRC/templates/AGENTS.md.tmpl" DATE "$STAMP" > "$TMP/agents-body"
put_once "AGENTS.md" "$TMP/agents-body"
if [ "$DRY_RUN" -eq 0 ] && [ -f "$CONFIG" ]; then
  # The install-once contract for the project's own answers: on a RE-install (the previous
  # record exists), the block rewrite carries forward the existing practice pin instead of the
  # freshly hashed one - an --upgrade must never re-pin the standard by itself, because a pin
  # that silently follows the file defeats the only check that guards it (IN-02). A FIRST
  # install (no previous record) has nothing to carry forward: the rendered value is the pin.
  # The block file here is the RENDERED template ("key: value" lines, no tabs), so the match
  # anchors on the key prefix, not on a tab field ($1 == "practice" never fired under the
  # rendered shape and the freshly rendered NEW hash flowed straight through — an --upgrade
  # re-pinned the standard silently, exactly what IN-02 exists to catch).
  if [ -n "$PREV_FILES" ]; then
    KEEP_PRACTICE=$(g_agents_read "$CONFIG" practice)
    KEEP_PRACTICE_SHA=$(g_agents_read "$CONFIG" practice_sha256)
    if [ -n "$KEEP_PRACTICE" ]; then
      sed -i "s#^practice: .*\$#practice: $KEEP_PRACTICE#; s#^practice_sha256: .*\$#practice_sha256: $KEEP_PRACTICE_SHA#" "$TMP/agents-block"
    fi
  fi
  g_agents_write "$CONFIG" < "$TMP/agents-block" >/dev/null \
    || { g_err "could not write the gob block into $CONFIG"; exit 1; }
fi
# The security lane's decision record is created once, then YOURS: it is an answer to a question
# only the project can answer (G4 B3).
[ -f "$SRC/templates/boundary-waivers.tmpl" ] && put_once ".gob/boundary-waivers" "$SRC/templates/boundary-waivers.tmpl"

# the Hermes project tier (opt-in): --skills yes installs the FULL set under .hermes/skills/.
if [ "$SKILLS" = "yes" ] && part_wanted playbooks; then
  for d in "$SRC"/skills/*/; do
    [ -f "$d/SKILL.md" ] || continue
    name=$(basename "$d")
    put ".hermes/skills/$name/SKILL.md" "$d/SKILL.md"
  done
fi

# The vendored procedure tier under .gob/skills/ — the SELECTED set (this mirrors the rule
# library: a default set on, the rest held back and selectable). Default (yes|no): the 7 core
# skills whose rows (SK-01/02/04) ride every install, so a default install never disables its
# own rows. `all`: every skill in the repo. A name list: exactly those (validated above). put:
# hash-checked, so IN-02/SK-02 see them like any other payload file, and installed.json covers
# EXACTLY this set — no more, no fewer.
VENDOR_SKILLS="$CORE_SKILLS"
case "$SKILLS" in
  all)    VENDOR_SKILLS=$(skill_names | tr '\n' ' ') ;;
  yes|no) VENDOR_SKILLS="$CORE_SKILLS" ;;
  *)      VENDOR_SKILLS=$(printf '%s' "$SKILLS" | tr ',' ' ') ;;
esac
for name in $VENDOR_SKILLS; do
  [ -f "$SRC/skills/$name/SKILL.md" ] || continue
  put ".gob/skills/$name/SKILL.md" "$SRC/skills/$name/SKILL.md"
done

# no more, no fewer: remove any RECORDED skill file the new selection no longer covers, so
# installed.json (and SK-02) covers exactly the vendored set. Both cases read the previous
# record, so exactly what was installed is what goes:
#   * .hermes/skills/* goes when the Hermes tier is no longer selected (SKILLS != yes);
#   * .gob/skills/<name>/* goes when <name> left the vendored set (e.g. all -> no shrinks 18 -> 7).
# Empty directories left behind are pruned (deepest first).
if [ -n "$PREV_FILES" ]; then
  while IFS= read -r rel; do
    case "$rel" in
      .hermes/skills/*) [ "$SKILLS" = "yes" ] && continue ;;
      .gob/skills/*)
        sname=${rel#.gob/skills/}; sname=${sname%%/*}
        case " $VENDOR_SKILLS " in *" $sname "*) continue ;; esac ;;
      *) continue ;;
    esac
    dst="$TARGET/$rel"
    [ -f "$dst" ] || continue
    if [ "$DRY_RUN" -eq 1 ]; then
      g_info "plan: remove $rel (no longer selected)"
    else
      rm -f "$dst"
      g_info "removed $rel (no longer selected)"
    fi
  done <<EOF
$PREV_FILES
EOF
  if [ "$DRY_RUN" -eq 0 ]; then
    find "$TARGET/.hermes" "$TARGET/.gob/skills" -depth -type d -exec rmdir {} + 2>/dev/null
  fi
fi

if [ "$WANT_SPEC" -eq 1 ] && part_wanted spec; then
  render "$SRC/templates/SPEC.md.tmpl" DATE "$STAMP" > "$TMP/spec"
  put_once "ROUND-000-SPEC.md" "$TMP/spec"
fi
if [ "$ARCHIVE" != "true" ] && part_wanted handoff; then
  # The HANDOFF names the gate the way GT-02 runs it: by the command's own name key
  # (gate_<name>_cmd), so HP-03 anchors on a declared name even when --gate replaced the
  # default command. GATE2_LINE renders the second gate (if any) the same way — a Gates
  # section that names only gate 1 while AGENTS.md declares two is the HP-03 day-one
  # anchoring red. With no second gate an empty line is rendered.
  if [ -n "$GATE2_NAME" ]; then
    GATE2_LINE="- \`$GATE2_NAME\` = 0 · measured $STAMP"
  else
    GATE2_LINE=""
  fi
  render "$SRC/templates/HANDOFF.md.tmpl" DATE "$STAMP" HEAD "$HEAD_SHORT" GATE_NAME "$GATE_NAME" GATE_CMD "$GATE_CMD" GATE2_LINE "$GATE2_LINE" > "$TMP/handoff"
  put_once "HANDOFF.md" "$TMP/handoff"
fi

if [ "$WANT_REVIEWS" -eq 1 ]; then
  printf '# Review verdicts live here: reviews/<slug>-<head7>.md, each naming the SHA it reviewed.\n' > "$TMP/gitkeep"
  put_once "reviews/.gitkeep" "$TMP/gitkeep"
fi

if [ "$SCAFFOLD" = "yes" ]; then
  put "$HARNESS_DIR/gate.sh" "$SRC/templates/checks/gate.sh.tmpl"
  put "$HARNESS_DIR/assert.mjs" "$SRC/templates/checks/assert.mjs.tmpl"
fi

# .gitignore: one appended block, delimited by markers; never rewritten. The declared
# runtime_data paths are listed too, because DS-01 asserts each of them is git-ignored.
GI_MARK="# >>> goblin-stack >>>"
if [ -f "$TARGET/.gitignore" ] && grep -qF "$GI_MARK" "$TARGET/.gitignore"; then
  SKIPPED=$((SKIPPED + 1))
  g_info "kept (.gitignore block already present)"
else
  {
    [ -f "$TARGET/.gitignore" ] && cat "$TARGET/.gitignore"
    printf '\n%s\n' "$GI_MARK"
    printf '# goblin-stack runtime state (gates write these; they are not fixture)\n'
    printf '.gob/last-gate-line\n.gob/.ds-report\n.gob/ratchet-last\n'
    if [ "$SEC_GITIGNORE_FAMILY" = "yes" ]; then
      # SC-02: the whole secret family, not one member of it. The row is behavioural - it asks
      # git's own matcher (`git check-ignore`) rather than reading this file - so a rule that
      # looks right but does not match still fails.
      printf '# the secret family (SC-02): each is one `git add` away from a live credential\n'
      printf '.env\n.env.*\n*.pem\n*.key\n'
    fi
    if [ -n "$RUNTIME_DATA" ]; then
      printf '# declared runtime_data (DS-01 hashes them around every gate run)\n'
      printf '%s\n' "$RUNTIME_DATA"
    fi
    printf '# <<< goblin-stack <<<\n'
  } > "$TMP/gitignore.new"
  if [ -f "$TARGET/.gitignore" ]; then UPDATED=$((UPDATED + 1)); else CREATED=$((CREATED + 1)); fi
  # Counted in --dry-run too: the plan must name every write it would make (D14).
  if [ "$DRY_RUN" -eq 0 ]; then cp "$TMP/gitignore.new" "$TARGET/.gitignore"; fi
fi

# installed.json is the record; it is written LAST and never lists itself
{
  printf '{\n'
  printf '  "version": "%s",\n' "$VERSION"
  printf '  "source_sha": "%s",\n' "$( cd "$SRC" && git rev-parse HEAD 2>/dev/null || echo unknown )"
  printf '  "installed_at": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  "options": {"skills": "%s", "archive": %s, "parts": "%s"},\n' "$SKILLS" "$ARCHIVE" "${PARTS:-all}"
  printf '  "files": {\n'
  awk -F'\t' 'NF==2 {printf "    \"%s\": \"%s\",\n", $1, $2}' "$TMP/files.tsv" | sed '$ s/,$//'
  printf '  },\n'
  printf '  "owned": {\n'
  awk -F'\t' 'NF==2 {printf "    \"%s\": \"%s\",\n", $1, $2}' "$TMP/owned.tsv" | sed '$ s/,$//'
  printf '  },\n'
  printf '  "refused": {\n'
  awk -F'\t' 'NF==2 {printf "    \"%s\": \"%s\",\n", $1, $2}' "$TMP/refused.tsv" | sed '$ s/,$//'
  printf '  }\n'
  printf '}\n'
} > "$TMP/installed.json"

PREV_VERSION=""
RECORD_SKILLS_EFFECTIVE=""
if [ -f "$INSTALLED" ]; then
  PREV_VERSION=$(g_installed_scalar "$INSTALLED" version)
  # The record's own skills choice (after the migration read above): a flip of the effective
  # choice IS a change even when no file hash moved — the explicit --skills no re-install must
  # rewrite the record (and drop the files), never report no-op over a state change.
  RECORD_SKILLS_EFFECTIVE=$(g_installed_scalar_options "$INSTALLED" skills)
fi


if [ "$DRY_RUN" -eq 0 ]; then
  if [ "$CREATED" -eq 0 ] && [ "$UPDATED" -eq 0 ] && [ "$PREV_VERSION" = "$VERSION" ] \
     && [ "$(printf '%s' "$RECORD_SKILLS_EFFECTIVE" )" = "$(printf '%s' "$SKILLS")" ]; then
    g_info "no-op: $UNCHANGED files unchanged (v$VERSION already installed)"
  else
    cp "$TMP/installed.json" "$INSTALLED"
    if [ -n "$PREV_VERSION" ] && [ "$PREV_VERSION" != "$VERSION" ]; then
      g_info "upgraded $PREV_VERSION -> $VERSION"
    fi
    g_info "created $CREATED · updated $UPDATED · unchanged $UNCHANGED · skipped $SKIPPED"
  fi
  if [ -n "$OPT_OUT" ] && grep -q "^$GOB_AGENTS_BEGIN" "$CONFIG" 2>/dev/null; then
    cur=$(g_agents_read "$CONFIG" disabled)
    new=$(printf '%s,%s' "${cur#[]}" "${OPT_OUT}" | tr ',' '\n' | grep -v '^$' | sort -u | paste -sd, -)
    {
      while IFS=$'\t' read -r k v; do
        [ "$k" = "disabled" ] && continue
        printf '%s\t%s\n' "$k" "$v"
      done < <(g_agents_pairs "$CONFIG")
      printf 'disabled\t[%s]\n' "$new"
    } | g_agents_write "$CONFIG" >/dev/null
    g_info "recorded opt-out: $OPT_OUT"
  fi
  g_info ""
  # ONE ordered next-steps list, shared with `gob init` (g_next_block, bin/goblin-lib.sh), and
  # every line true of the artefact. When `gob init --write` ran this install it defers the block
  # (GOB_NEXT_DEFER) and prints the same list itself at the end, so a user never sees two lists.
  if [ "${GOB_NEXT_DEFER:-0}" != "1" ]; then
    g_next_block "$TARGET" "$SKILLS" "$GATE_LABEL"
  fi
  g_info ""
else
  g_info "dry-run: created $CREATED · updated $UPDATED · unchanged $UNCHANGED · skipped $SKIPPED"
fi

if [ -n "$REFUSED_PATHS" ]; then
  g_info "refused to overwrite:$REFUSED_PATHS (kept - reconcile it: docs/GUIDE.md; --force would destroy it)"
  # Documented contract (docs/GUIDE.md, this file's header): exit 1 is "a refusal, with
  # the path and the fix". A wrapper has to be able to detect it (D2).
  exit 1
fi
exit 0
