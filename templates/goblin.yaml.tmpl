# .goblin/goblin.yaml — the project config. Generated once by goblin-install, then YOURS.
# It is never overwritten after the first install: edit it in place.
#
# Format: a flat, line-oriented YAML subset, parsed by .goblin/bin/goblin-lib.sh. No YAML
# library, no network, no npm. Keep one key per line and keep comments on their own line.

# Which class this project is (A|B|C|D|E). Selects the required parts (manifest/classes.tsv).
class: {{CLASS}}

# The default branch, DECLARED, never assumed. A preset that assumes the wrong branch
# silently skips a repo.
branch: {{BRANCH}}

# The model mapping — the ONE install-time machine input. goblin-stack READS this file and
# never writes it. Absent on another machine: every model-dependent check reports advisory.
models_file: {{MODELS_FILE}}

# The referenced standard (optional). goblin-stack carries no copy of it; it pins its hash.
practice: {{PRACTICE}}
practice_sha256: {{PRACTICE_SHA}}

# The commit identity this repo expects (CM-01).
owner_email: {{OWNER_EMAIL}}

# archive: true -> verify requires no HANDOFF and no gates, and says so.
archive: {{ARCHIVE}}

# Uncommitted entries allowed at verify time (CM-03). 0 means commit as you go.
max_dirty: {{MAX_DIRTY}}

# Unenforceable rules are counted; this is the cap that stops the matrix decaying into prose.
advisory_ceiling: {{ADVISORY_CEILING}}

# Whether this class requires a client-visible surface to be secret-free (SC-01..SC-09 read the
# `security:` block below). Declared, never inferred: a stack-specific rule guessed from the
# files on disk is how a matrix starts lying.
security:
  gitignore_family: {{SEC_GITIGNORE_FAMILY}}
  build_output: {{SEC_BUILD_OUTPUT}}
  audit_cmd: {{SEC_AUDIT_CMD}}
  audit_max_age_days: {{SEC_AUDIT_MAX_AGE}}
  waiver_max_age_days: {{SEC_WAIVER_MAX_AGE}}
  write_routes: {{SEC_WRITE_ROUTES}}

# The performance budget (PF-01). The NUMBER lives in `ratchet:` above — this block only names
# the commit it was measured on, so "I raised the ceiling" cannot silently become "I never
# measured again". An empty baseline_commit means "not measured yet" and PF-01 skips with that
# reason; a baseline_commit that does not resolve to an ancestor of HEAD is a RED.
perf:
  metric: {{PERF_METRIC}}
  cmd: {{PERF_CMD}}
  baseline_commit: {{PERF_BASELINE_COMMIT}}
  baseline_value: {{PERF_BASELINE_VALUE}}
  measured: {{PERF_MEASURED}}
  host_gate: {{PERF_HOST_GATE}}

# Where the asserting harnesses live.
harness_dir: {{HARNESS_DIR}}

# Whether this class scaffolds that directory. A declared harness_dir that is absent FAILS
# (HS-01) when this is yes; a class that ships no harness dir skips with a reason.
scaffold_checks: {{SCAFFOLD_CHECKS}}

# The feature map (P6's inventory, authored by skills/goblin-feature-map).
# feature_map: the map's README, relative to this repo. EMPTY means "no map declared yet" and
# makes FM-01/FM-02 SKIP with that reason - a fresh install has no map and must not be born RED.
# source_root: entry paths in the map resolve against this.
# verify_doctor: the command the map's own instructions say to run. EMPTY -> VA-01 SKIPs.
feature_map: {{FEATURE_MAP}}
source_root: {{SOURCE_ROOT}}
verify_doctor: {{VERIFY_DOCTOR}}

# The loop ceiling (G2, LP-03). The most turns ONE loop record may declare in its budget, so a
# runaway loop cannot buy itself unlimited iterations. 20 is the engine's own default for a
# kanban goal loop, measured; a ceiling that does not match the engine's default is a number
# someone made up. It bounds one loop's turns, never how many loops exist.
loop_max_turns_ceiling: {{LOOP_MAX_TURNS}}

# The gate set. DECLARED, never inferred from the stack. Replace the default below with the
# real commands for this project; each must exit 0.
gates:
{{GATES}}
{{GATE2}}

# A count that must not rise, with its ceiling. The ceiling was measured at install time.
ratchet:
  name: {{RATCHET_NAME}}
  cmd: {{RATCHET_CMD}}
  ceiling: {{RATCHET_CEILING}}

# Paths a probe must never write (DS-01/DS-02 hash them around every gate run).
runtime_data:
{{RUNTIME_DATA}}

# The ban list (G5). Which bans this project turns on; an unlisted ban SKIPs with a reason.
# A ban's mechanism lives in .goblin/manifest/bans.tsv; the engine is .goblin/bin/goblin-bans.
bans: [{{BANS}}]

# Narrow, explicit, reviewed exceptions (Dune rule 5): "- <ban id> <path prefix>".
bans_exempt:
{{BANS_EXEMPT}}

# What BN-05 reads: "<from> <to>" layer pairs. Empty -> BN-05 SKIPs with a reason.
layers:
{{LAYERS}}

# How a harness proves RED on the pre-change tree (HS-02). Set commit: to the pinned
# pre-change SHA once the round it guards has landed; until then HS-02 is skipped with a reason.
replay:
  env: {{REPLAY_ENV}}
  cmd: {{REPLAY_CMD}}
  commit: ""

# Parts recorded as opt-out. Their required checks report SKIP (opt-out) rather than passing.
disabled: [{{DISABLED}}]
